---
import {categories,categoryFor,ordered,PAGE_SIZE,type Entry} from '../lib/content';
interface Props{entries:Entry[];section:'blog'|'guides'|'glossary';page?:number;category?:string}
const {entries,section,page=1,category}=Astro.props;
const all=ordered(entries.filter(a=>a.data.section===section));
const selected=category?all.filter(a=>categoryFor(a)===category):all;
const shown=section==='blog'&&!category?selected.slice((page-1)*PAGE_SIZE,page*PAGE_SIZE):selected;
const totalPages=Math.ceil(all.length/PAGE_SIZE);
const guideGroups=['Windows','Android','iOS','macOS','通用'].map(platform=>({platform,list:all.filter(a=>categoryFor(a)==='操作教程 · '+platform)})).filter(g=>g.list.length);
---
{section==='blog'&&<div class="directory-layout"><aside class="directory-sidebar"><h2>阅读分类</h2><nav class="category-nav" aria-label="文章分类"><a href="/blog/" aria-current={!category?'page':undefined}><span>全部文章</span><small>{all.length}</small></a>{categories.map(c=><a href={'/blog/category/'+c.slug+'/'} aria-current={category===c.name?'page':undefined}><span>{c.name}</span><small>{all.filter(a=>categoryFor(a)===c.name).length}</small></a>)}</nav><div class="editorial-note"><p>需要动手操作？</p><a href="/guides/">前往分平台教程 →</a></div></aside><div class="directory-main"><div class="directory-heading"><span>{category||'全部文章'}</span><small>{category?shown.length+' 篇':'共 '+all.length+' 篇 · 第 '+page+' / '+totalPages+' 页'}</small></div>{shown.map((a,i)=><article class="reading-row"><span class="reading-number">{String((page-1)*PAGE_SIZE+i+1).padStart(2,'0')}</span><div><span class="article-kicker">{categoryFor(a)}</span><h2><a href={'/blog/'+a.id+'/'}>{a.data.title}</a></h2><p>{a.data.description}</p><span class="entry-date">更新 {a.data.updated} · AI 辅助整理</span></div><a class="reading-arrow" aria-label={'阅读 '+a.data.title} href={'/blog/'+a.id+'/'}>↗</a></article>)}{!category&&totalPages>1&&<nav class="pagination" aria-label="文章分页">{Array.from({length:totalPages},(_,i)=>i+1).map(n=><a href={n===1?'/blog/':'/blog/page/'+n+'/'} aria-label={'第 '+n+' 页'} aria-current={n===page?'page':undefined}>{n}</a>)}</nav>}</div></div>}
{section==='guides'&&<div class="directory-layout guide-directory"><aside class="directory-sidebar"><p class="eyebrow">QUICK START</p><h2>选择你的平台</h2><nav class="category-nav" aria-label="教程平台">{guideGroups.map(g=><a href={'#tutorial-'+g.platform}><span>{g.platform}</span><small>{g.list.length} 篇</small></a>)}</nav><div class="editorial-note"><p>一步操作，一次验证。</p><small>每篇教程包含准备、6 个操作步骤、结果检查和恢复方法。</small></div></aside><div class="directory-main">{guideGroups.map((g,i)=><section class="guide-group" id={'tutorial-'+g.platform}><div class="guide-heading"><span class="guide-platform-number">0{i+1}</span><h2>{g.platform} 教程</h2><span>{g.list.length} 篇</span></div>{g.list.map(a=><article class="guide-item"><div><h3><a href={'/guides/'+a.id+'/'}>{a.data.title}</a></h3><p>{a.data.description}</p></div><a href={'/guides/'+a.id+'/'} aria-label={'查看步骤：'+a.data.title}>→</a></article>)}</section>)}</div></div>}
{section==='glossary'&&<div class="glossary-list">{shown.map((a,i)=><article class="glossary-entry"><span class="pick-index">{String(i+1).padStart(2,'0')}</span><div><h2><a href={'/glossary/'+a.id+'/'}>{a.data.title}</a></h2><p>{a.data.description}</p></div><a class="text-link" href={'/glossary/'+a.id+'/'}>了解概念 ↗</a></article>)}</div>}
