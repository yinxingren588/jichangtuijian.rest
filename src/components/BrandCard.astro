---
import {planPriceText,planTrafficText,sourceLabel,type Airport} from '../data/airports';
import Coupon from './Coupon.astro';
const {brand:a}=Astro.props as {brand:Airport};
const plan=a.plans[0];
---
<article class="card"><div class="brand-top"><span class="brand-icon" aria-hidden="true">{a.name.slice(0,1)}</span><span class="tag">{a.kind==='vpn'?'VPN':'订阅机场'} · {sourceLabel(a)}</span></div><h3><a href={'/airport/'+a.slug+'/'}>{a.name}</a></h3><p>{a.description}</p><dl class="facts"><div><dt>入门方案 / 价格口径</dt><dd>{plan?planPriceText(plan):'尚未核实'}</dd></div><div><dt>参考流量</dt><dd>{plan?planTrafficText(plan):'尚未核实'}</dd></div></dl>{a.kind==='airport'?<Coupon brand={a}/>:<p>注意：{a.disadvantages[0]}</p>}<div class="actions"><a href={'/airport/'+a.slug+'/'} class="text-link">{a.plans.length?'查看 '+a.plans.length+' 档套餐':'查看资料'} →</a>{a.affiliateUrl&&<a class="button" href={a.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">推广入口 ↗</a>}</div></article>
