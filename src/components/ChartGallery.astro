---
import {chartSize,type ChartAsset} from '../data/evidence';
interface Props {name:string;speed:ChartAsset;unlock:ChartAsset;summary?:boolean}
const {name,speed,unlock,summary=false}=Astro.props;
const charts=[{asset:speed,title:summary?'晚高峰测速汇总':'节点测速图',text:'延迟、下载速度与节点记录',kind:'SPEED / 01'},{asset:unlock,title:summary?'流媒体与 AI 解锁汇总':'流媒体与 AI 解锁图',text:'平台状态、地区与节点记录',kind:'ACCESS / 02'}];
---
<div class="chart-gallery">{charts.map(({asset,title,text,kind})=><figure class="chart-card"><figcaption><span class="eyebrow">{kind}</span><h3>{title}</h3><p>{text}</p></figcaption><a class="chart-preview" href={asset.original} target="_blank" rel="noopener" data-chart-open data-chart-title={name+' · '+title} aria-label={'放大查看'+name+'的'+title}><img src={asset.preview} width={asset.previewWidth} height={asset.previewHeight} loading="lazy" decoding="async" alt={name+' · '+title+'，维护者提供，详细节点结果见高清原图'}/><span class="chart-preview-action">放大查看完整图表 ↗</span></a><div class="chart-actions"><a href={asset.original} target="_blank" rel="noopener">打开原图 ↗</a><a href={asset.original} download={name+'_'+title+'.png'}>下载 PNG ↓</a></div><p class="chart-meta">{asset.width} × {asset.height} · 原图 {chartSize(asset)}</p></figure>)}</div>
