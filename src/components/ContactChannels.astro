---
import {contact} from '../data/contact';
---
<div class="contact-channels" aria-label="联系站长的方式">
 <a class="contact-channel contact-email" href={contact.emailUrl}>
  <span class="contact-channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></span>
  <span class="contact-channel-copy"><strong>Gmail 邮件</strong><span>{contact.email}</span><small>适合详细需求、合作提案与资料补充</small></span>
  <span class="contact-channel-arrow" aria-hidden="true">↗</span>
 </a>
 <a class="contact-channel contact-telegram" href={contact.telegramUrl} target="_blank" rel="noopener noreferrer">
  <span class="contact-channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M21 3 3 10.3l7 2.7L12.7 20 21 3Z"/><path d="m10 13 6-5"/></svg></span>
  <span class="contact-channel-copy"><strong>Telegram 私讯</strong><span>{contact.telegram}</span><small>适合简短咨询与后续沟通</small></span>
  <span class="contact-channel-arrow" aria-hidden="true">↗</span>
 </a>
</div>
