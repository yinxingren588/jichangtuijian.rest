---
import {planPriceText,planTrafficText,sourceLabel,type Airport} from '../data/airports';
import {evidenceFor} from '../data/evidence';
import {couponNotes} from '../data/coupon-notes';
import Coupon from './Coupon.astro';
interface Props {brand:Airport}
const {brand:a}=Astro.props;const plan=a.plans[0];const evidence=evidenceFor(a.slug);const coupon=couponNotes[a.slug];
---
<section class="brand-snapshot" aria-labelledby="brand-snapshot-title" data-brand-snapshot={a.slug}>
 <div class="snapshot-heading"><div><p class="eyebrow">AT A GLANCE / 一眼看懂</p><h2 id="brand-snapshot-title">先看这四项，再读详细资料。</h2></div><span class="tag neutral">{sourceLabel(a)}</span></div>
 <dl class="snapshot-grid"><div><dt>首档方案参考价</dt><dd>{plan?planPriceText(plan):'价格待核实'}<small>{plan?.name||'尚未录入套餐报价'}</small></dd></div><div><dt>对应流量与发放方式</dt><dd>{plan?planTrafficText(plan):'流量待核实'}<small>与左侧同一方案 · {a.plans.length} 档资料已收录</small></dd></div><div><dt>优惠码与条件</dt><dd><Coupon brand={a} compact/><small>{coupon?coupon.short+' · 结算待核实':a.coupon?'折扣与有效期待核实':'未提供优惠码'}</small></dd></div><div><dt>图示测速日期</dt><dd>{evidence?<time>{evidence.time.slice(0,10)}</time>:'尚无图表'}<small>{evidence?'60 个节点 · 维护者提供，未独立复测':'套餐说明不能代替实际测量'}</small></dd></div></dl>
 <div class="snapshot-actions"><a class="button" href="#plans-heading">看完整套餐 ↓</a><a class="quiet-button" href="#performance-evidence">{evidence?'看测速与解锁图':'看测速资料状态'} ↗</a><a class="text-link" href={'/compare/?brands='+a.slug}>加入品牌对照 ⇄</a></div>
 <p class="snapshot-footnote">{plan?.priceKind==='monthly-equivalent'?'首档为年付折算月均展示，完整年付总额待确认，不能按月支付该金额。':plan?.period==='year'?'首档价格为完整年付总额；流量按所标发放周期理解。':plan?.period==='free'?'免费方案与付费方案的设备、地区和功能范围应分别核对。':'价格保留付款周期，流量保留重置口径；优惠不自动计入标价。'}资料查看日期：{a.referenceChecked||a.lastVerified||'待补充'}。</p>
</section>
<nav class="brand-mobile-actions" aria-label="手机品牌快捷操作" data-coupon-box><a href="#plans-heading"><span aria-hidden="true">▤</span>看套餐</a><a href="#performance-evidence"><span aria-hidden="true">▥</span>{evidence?'看测速':'测速状态'}</a>{a.coupon?<button type="button" class="coupon-copy" data-coupon={a.coupon.code} aria-label={'复制 '+a.name+' 优惠码（底部快捷）'}><span aria-hidden="true">⧉</span>复制优惠码</button>:<a href="#coupon-heading"><span aria-hidden="true">◇</span>优惠说明</a>}<span class="coupon-status" role="status" aria-live="polite"></span></nav>
