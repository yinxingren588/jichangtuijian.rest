---
import type {Airport} from '../data/airports';
const {brand:a,compact=false}=Astro.props as {brand:Airport;compact?:boolean};
---
{a.coupon?<div class="coupon" data-coupon-box><span class="muted">优惠码</span><code>{a.coupon.code}</code><button type="button" class="coupon-copy" data-coupon={a.coupon.code} aria-label={'复制 '+a.name+' 优惠码'}>复制</button>{!compact&&<small>{a.coupon.validity==='permanent'?'优惠价永久有效 · 站长确认':'具体优惠条件待补充'}</small>}<span class="coupon-status" role="status" aria-live="polite"></span></div>:<p class="muted">优惠码：未提供</p>}
<script>document.querySelectorAll<HTMLButtonElement>('.coupon-copy').forEach(button=>button.addEventListener('click',async()=>{const status=button.closest<HTMLElement>('[data-coupon-box]')!.querySelector<HTMLElement>('.coupon-status')!;try{await navigator.clipboard.writeText(button.dataset.coupon!);status.textContent='已复制';setTimeout(()=>{if(status.textContent==='已复制')status.textContent='';},3500);}catch{status.textContent='请手动复制上方优惠码';}}));</script>
