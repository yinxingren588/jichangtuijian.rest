---
import {couponNotes} from '../data/coupon-notes';
const {slug}=Astro.props as {slug:string};const note=couponNotes[slug];
---
{note&&<div class="coupon-conditions" data-coupon-research={note.status}><div><h3>优惠条件</h3><span class="tag neutral">{note.status==='owner-confirmed'?'永久有效 · 站长确认':'条件待补充'}</span></div><dl><div><dt>折扣资料</dt><dd>{note.discount}</dd></div><div><dt>适用条件</dt><dd>{note.conditions}</dd></div><div><dt>有效期</dt><dd>{note.validity}</dd></div><div><dt>有效期确认日期</dt><dd><time>{note.checked}</time> · 站长确认</dd></div></dl><p>{note.caution}</p><a class="text-link" href="/guides/check-coupon-without-payment/">核对优惠是否生效的六步流程 →</a></div>}
