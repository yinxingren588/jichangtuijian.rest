---
import Coupon from './Coupon.astro';
import {topics} from '../data/site';
import {planPriceText,planTrafficText} from '../data/airports';
import {topicRanking,topicRankingRules,type TopicSlug} from '../data/topic-rankings';
const {slug}=Astro.props as {slug:TopicSlug};
const topic=topics.find(t=>t.slug===slug)!;
const rows=topicRanking(slug);
const rules=topicRankingRules[slug];
---
<div class="topic-browser" data-topic-browser>
<nav class="topic-tabs" aria-label="六个品牌排行专题">{topics.map(t=><a href={'/recommend/'+t.slug+'/'} aria-current={t.slug===slug?'page':undefined}>{t.name}<span>10</span></a>)}</nav>
<section class="topic-leaderboard" aria-labelledby="topic-ranking-heading" data-topic-ranking={slug}>
 <div class="section-head"><div><p class="eyebrow">TOP 10 / EDITOR'S LIST</p><h2 id="topic-ranking-heading">{topic.name} · 十品牌参考排行</h2><p>套餐、流量与图表入口，一次看清。</p></div><a class="text-link" href={'/compare/?brands='+rows.slice(0,2).map(r=>r.brand.slug).join(',')}>对比榜单前两家 ⇄</a></div>
 <div class="topic-method" id="topic-ranking-method"><strong>{rules.label}</strong><p>{rules.method}</p><details><summary>查看数据口径与适用范围</summary><p>{rules.limit}</p><p>这是编辑参考排行，包含站点指定展示位；不设虚构评分。图表由维护者提供，尚未独立复测。机场品牌含推广链接，本站可能获得佣金。<a href="/editorial-policy/">完整排序说明 ↗</a></p></details></div>
 <p class="fine-print">套餐为参考资料；图表由维护者提供，尚未独立复测。名次依照上述编辑口径展示。</p>
 <div class="topic-overview" id="topic-overview" aria-labelledby="topic-overview-heading">
  <div class="topic-overview-heading"><div><p class="eyebrow">COMPARE AT A GLANCE</p><h3 id="topic-overview-heading">十品牌总览</h3></div><a href="#topic-detailed-list" class="text-link">直接看详细介绍 ↓</a></div>
  <form action="/compare/" method="get" class="topic-selection-toolbar" data-topic-selection-toolbar hidden><input type="hidden" name="brands" data-topic-selected-values/><p role="status" aria-live="polite" data-topic-selection-status>勾选 2–4 个品牌，放在一起比较。</p><div><button type="button" data-topic-selection-clear disabled>清空</button><button type="submit" class="button" data-topic-selection-submit disabled>对比已选（0/4） ⇄</button></div></form>
  <p class="topic-table-hint">手机可左右滑动查看完整表格；点击品牌名称查看详情，点击名次定位下方介绍。</p>
  <div class="topic-overview-scroll" role="region" aria-label={topic.name+'十品牌总览，可横向滚动'} tabindex="0"><table class="topic-overview-table"><caption>{topic.name}十品牌参考套餐 · 价格未扣除优惠，付款周期分别标明</caption><thead><tr><th scope="col">名次 / 品牌</th><th scope="col">参考价格</th><th scope="col">标示流量</th><th scope="col">优惠码</th><th scope="col">专题重点</th><th scope="col">资料入口</th></tr></thead><tbody>{rows.map(r=><tr data-overview-brand={r.brand.slug}>
   <th scope="row"><div class="topic-overview-brand"><label class="topic-selection-check" data-topic-selection-control hidden><input type="checkbox" value={r.brand.slug} data-topic-select aria-label={'选择 '+r.brand.name+' 加入对比'}/></label><a class="topic-overview-rank" href={'#rank-'+r.brand.slug} aria-label={'定位第 '+r.rank+' 名 '+r.brand.name}>{String(r.rank).padStart(2,'0')}</a><a href={'/airport/'+r.brand.slug+'/'}>{r.brand.name}</a></div></th>
   <td><strong>{planPriceText(r.plan)}</strong><small>{r.plan.name}</small></td><td>{planTrafficText(r.plan)}</td><td><Coupon brand={r.brand} compact/></td><td><span>{r.metric.label}</span><strong>{r.metric.value}</strong></td><td><a href={'/airport/'+r.brand.slug+'/#plans-heading'}>套餐 ↗</a><a href={'/airport/'+r.brand.slug+'/#performance-evidence'}>测速图 ↗</a></td>
  </tr>)}</tbody></table></div>
 </div>
 <nav class="topic-rank-jumps" aria-label={topic.name+'榜单快速定位'}>{rows.map(r=><a href={'#rank-'+r.brand.slug}><b>{String(r.rank).padStart(2,'0')}</b>{r.brand.name}</a>)}</nav>
 <ol class="topic-rank-list" id="topic-detailed-list">{rows.map(r=><li id={'rank-'+r.brand.slug} data-ranked-brand={r.brand.slug} class:list={['topic-rank-card',{'topic-rank-first':r.rank===1}]}>
  <div class="topic-rank-number"><span>RANK</span><b>{String(r.rank).padStart(2,'0')}</b></div>
  <div class="topic-rank-content"><div class="topic-rank-brand"><span class="brand-monogram" aria-hidden="true">{r.brand.name[0]}</span><div><h3><a href={'/airport/'+r.brand.slug+'/'}>{r.brand.name}</a></h3><span>{r.rank===1?'本专题首位':'专题候选品牌'} · 第三方参考资料</span></div></div><p>{r.reason}</p><div class="topic-rank-metric"><span>{r.metric.label}</span><strong>{r.metric.value}</strong></div>{r.chartTime&&<p class="topic-chart-time">图表场景：<time datetime={r.chartTime.slice(0,10)}>{r.chartTime}</time> · 时区未提供</p>}</div>
  <div class="topic-rank-plan"><span class="topic-plan-label">{r.plan.period==='month'?'月付参考套餐':'参考套餐 · 核对计费周期'}</span><strong>{planPriceText(r.plan)}</strong><span>{r.plan.name}</span><p>{planTrafficText(r.plan)}</p><Coupon brand={r.brand} compact/><small>结算金额与优惠适用条件需再次确认</small></div>
  <div class="topic-rank-actions"><a class="topic-brand-link" href={'/airport/'+r.brand.slug+'/'}>查看品牌详情 ↗</a><a href={'/airport/'+r.brand.slug+'/#plans-heading'}>全部套餐 →</a><a href={'/airport/'+r.brand.slug+'/#performance-evidence'}>测速与解锁图 →</a><a href={'/compare/?brands='+[r.brand.slug,rows[r.rank===1?1:0].brand.slug].join(',')}>加入双品牌对比 ⇄</a><a class="topic-back-top" href="#topic-ranking-heading">返回榜首 ↑</a></div>
 </li>)}</ol>
</section>
<div class="topic-mobile-tools"><div class="topic-mobile-panel" id="topic-mobile-panel" hidden><div><strong>切换需求专题</strong><button type="button" data-topic-panel-close aria-label="收起专题选择">收起 ×</button></div><nav aria-label="手机专题切换">{topics.map(t=><a href={'/recommend/'+t.slug+'/'} aria-current={t.slug===slug?'page':undefined}>{t.name}<span>10 个品牌 ↗</span></a>)}</nav></div><nav class="topic-mobile-bar" aria-label="手机榜单快捷操作"><button type="button" data-topic-panel-toggle hidden aria-expanded="false" aria-controls="topic-mobile-panel"><span aria-hidden="true">☷</span>切换专题</button><a href="/recommend/" data-topic-panel-fallback>切换专题</a><a href="#topic-overview"><span aria-hidden="true">▤</span>品牌总览</a><a href="#topic-ranking-heading"><span aria-hidden="true">↑</span>返回榜首</a><a href="#topic-overview" data-topic-mobile-compare><span aria-hidden="true">⇄</span><span data-topic-mobile-compare-label>选择对比</span></a></nav></div>
</div>
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-topic-browser]')){
 const checkboxes=[...root.querySelectorAll<HTMLInputElement>('[data-topic-select]')];
 const toolbar=root.querySelector<HTMLElement>('[data-topic-selection-toolbar]')!;
 const values=root.querySelector<HTMLInputElement>('[data-topic-selected-values]')!;
 const submit=root.querySelector<HTMLButtonElement>('[data-topic-selection-submit]')!;
 const clear=root.querySelector<HTMLButtonElement>('[data-topic-selection-clear]')!;
 const status=root.querySelector<HTMLElement>('[data-topic-selection-status]')!;
 const mobileCompare=root.querySelector<HTMLAnchorElement>('[data-topic-mobile-compare]')!;
 const mobileLabel=root.querySelector<HTMLElement>('[data-topic-mobile-compare-label]')!;
 const selected=()=>checkboxes.filter(input=>input.checked).map(input=>input.value);
 function update(){const slugs=selected(),ready=slugs.length>=2;values.value=slugs.join(',');submit.disabled=!ready;clear.disabled=slugs.length===0;
  submit.textContent=`对比已选（${slugs.length}/4） ⇄`;
  status.textContent=slugs.length===0?'勾选 2–4 个品牌，放在一起比较。':slugs.length===1?'已选 1 个品牌，再选 1 个即可比较。':`已选 ${slugs.length} 个品牌，可以打开对比。`;
  mobileCompare.href=ready?'/compare/?brands='+encodeURIComponent(slugs.join(',')):'#topic-overview';mobileLabel.textContent=ready?`对比（${slugs.length}）`:'选择对比';
  for(const input of checkboxes)input.closest('tr')?.classList.toggle('topic-row-selected',input.checked);
 }
 toolbar.hidden=false;root.querySelectorAll<HTMLElement>('[data-topic-selection-control]').forEach(control=>control.hidden=false);
 for(const input of checkboxes)input.addEventListener('change',()=>{if(selected().length>4){input.checked=false;update();status.textContent='最多比较 4 个品牌，请先取消一个已选品牌。';}else update();});
 clear.addEventListener('click',()=>{checkboxes.forEach(input=>input.checked=false);update();});
 toolbar.addEventListener('submit',event=>{if(selected().length<2||selected().length>4){event.preventDefault();status.textContent='请选择 2–4 个品牌后再比较。';}});
 update();
 const panel=root.querySelector<HTMLElement>('#topic-mobile-panel')!;const toggle=root.querySelector<HTMLButtonElement>('[data-topic-panel-toggle]')!;
 toggle.hidden=false;root.querySelector<HTMLElement>('[data-topic-panel-fallback]')!.hidden=true;
 function setPanel(open:boolean){panel.hidden=!open;toggle.setAttribute('aria-expanded',String(open));}
 toggle.addEventListener('click',()=>setPanel(panel.hidden));
 root.querySelector('[data-topic-panel-close]')!.addEventListener('click',()=>{setPanel(false);toggle.focus();});
 root.addEventListener('keydown',event=>{if(event.key==='Escape'&&!panel.hidden){setPanel(false);toggle.focus();}});
 root.querySelectorAll('.topic-mobile-bar>a').forEach(link=>link.addEventListener('click',()=>setPanel(false)));
 document.addEventListener('click',event=>{if(event.target instanceof Node&&!root.querySelector('.topic-mobile-tools')!.contains(event.target))setPanel(false);});
}
</script>
