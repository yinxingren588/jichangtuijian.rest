---
import Base from '../../layouts/Base.astro';
import {searchIntentTargets} from '../../data/search-intents';
---
<Base title="Bing搜索数据复盘工具｜查询、展现与点击的改进清单" description="在浏览器中导入自己的Bing站长工具CSV，确认字段和观察范围，再按展现、点击与平均位置整理改进建议；不上传文件，不生成虚构搜索数据。" noindex breadcrumbs={[{name:'搜索数据复盘',url:'/tools/search-review/'}]}>
 <header class="page-intro"><p class="eyebrow">EDITOR'S WORKBENCH</p><h1>从真实搜索数据，决定下一步。</h1><p>导入Bing站长工具的查询或页面CSV，确认列名后生成编辑检查清单。当前没有预填任何真实展现、点击或排名。</p></header>
 <section class="search-review-intro reader-value-intro"><h2>先保留一致的观察口径</h2><p>按相同日期范围、地区、设备和统计方式分别导出。工具分析单一表格，不把重复行直接合并，也不跨查询平均排名。文件仅在当前浏览器处理，不上传、不保存到本地存储。</p><div class="case-reading"><a href="/downloads/search-review-template.csv" download>下载标准CSV表头 ↓</a><a href="https://www.bing.com/webmasters/" target="_blank" rel="noopener noreferrer">打开Bing站长工具 ↗</a><a href="/share/">返回内容维护与分享 →</a></div></section>
 <section class="reader-value-card" aria-labelledby="import-search-data"><h2 id="import-search-data">1. 导入自己的数据</h2><label for="search-csv-file">CSV文件（UTF-8，最多5MB / 10000行）</label><input id="search-csv-file" type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values"/><details class="search-paste"><summary>也可以粘贴CSV内容</summary><label for="search-csv-paste">包含表头的CSV或制表符文本</label><textarea id="search-csv-paste" rows="6" maxlength="5000000" spellcheck="false"></textarea><button id="read-pasted-csv" class="quiet-button" type="button">读取粘贴内容</button></details><p id="search-import-status" role="status" aria-live="polite">尚未导入文件；没有数据时不显示零点击或虚构排名。</p></section>
 <section class="reader-value-card search-mapping" id="search-mapping" hidden aria-labelledby="mapping-heading"><h2 id="mapping-heading">2. 确认字段和本次参考线</h2><p>常见中英文表头会尝试匹配，仍请核对实际含义；不要将百分比列映射成点击数或平均位置。未知导出格式可手动选择。</p><div class="case-form"><label>关键词列<select id="map-query"></select></label><label>页面URL列（可选）<select id="map-page"></select></label><label>展现列<select id="map-impressions"></select></label><label>点击列<select id="map-clicks"></select></label><label>平均位置列（可选）<select id="map-position"></select></label><label>最低展现参考线<input id="review-minimum" type="number" min="1" max="1000000" step="1" value="50"/></label><label>点击率参考线（%）<input id="review-ctr" type="number" min="0" max="100" step="0.1" value="2"/></label><label>本次观察范围<input id="review-scope" type="text" maxlength="200" placeholder="例如：日期范围、地区、设备、查询维度"/></label><div class="case-form-action"><button id="analyze-search-data" type="button" class="button">生成编辑检查清单</button><button id="clear-search-data" type="button" class="quiet-button">清除本页导入数据</button></div></div><p class="fine-print">50次展现和2%点击率仅是可调整的筛选起点，不是行业标准或统计显著性门槛。平均位置也不是每次搜索的固定名次。</p></section>
 <section id="search-review-results" hidden aria-labelledby="results-heading"><h2 id="results-heading">3. 按实际查询安排改进</h2><div id="search-summary" class="search-review-summary"></div><p id="search-results-status" role="status" aria-live="polite"></p><button id="export-search-review" type="button" class="button">下载完整复盘清单 CSV ↓</button><div class="reader-table-scroll" tabindex="0" role="region" aria-label="搜索数据建议表，可横向滚动"><table><thead><tr><th scope="col">查询 / 页面</th><th scope="col">展现</th><th scope="col">点击</th><th scope="col">点击率</th><th scope="col">平均位置</th><th scope="col">建议与依据</th></tr></thead><tbody id="search-results-body"></tbody></table></div></section>
 <script type="application/json" id="search-target-map" set:html={JSON.stringify(searchIntentTargets.map(t=>({keyword:t.keyword,path:t.url}))).replace(/</g,'\u003c')}/>
 <script>
  import {parseReviewCsv,suggestReviewMapping,observationsFromCsv,reviewRecommendation,exportReviewCsv,type CsvTable,type SearchObservation,type ReviewMapping,type ReviewSettings} from '../../lib/search-review';
  let table:CsvTable|null=null;let observations:SearchObservation[]=[];let settings:ReviewSettings={minimumImpressions:50,targetCtr:.02};
  const file=document.querySelector<HTMLInputElement>('#search-csv-file')!;const status=document.querySelector<HTMLElement>('#search-import-status')!;const mappingSection=document.querySelector<HTMLElement>('#search-mapping')!;const results=document.querySelector<HTMLElement>('#search-review-results')!;
  const keys=['query','page','impressions','clicks','position'] as const;
  const targets=JSON.parse(document.querySelector('#search-target-map')!.textContent!) as {keyword:string;path:string}[];
  const normalize=(value:string)=>value.toLowerCase().replace(/\s+/g,'');
  const clear=()=>{importRevision++;document.querySelector<HTMLTextAreaElement>('#search-csv-paste')!.value='';table=null;observations=[];file.value='';mappingSection.hidden=true;results.hidden=true;document.querySelector('#search-results-body')!.replaceChildren();document.querySelector('#search-summary')!.replaceChildren();status.textContent='本页导入数据已清除；没有上传或保存到浏览器本地存储。';};
  const readCsv=(text:string)=>{table=null;observations=[];results.hidden=true;mappingSection.hidden=true;try{table=parseReviewCsv(text);const suggestions=suggestReviewMapping(table.headers);for(const key of keys){const select=document.querySelector<HTMLSelectElement>('#map-'+key)!;select.replaceChildren();const blank=document.createElement('option');blank.value='-1';blank.textContent='未选择';select.append(blank);table.headers.forEach((header,index)=>{const option=document.createElement('option');option.value=String(index);option.textContent=header;select.append(option);});select.value=String(suggestions[key]);}mappingSection.hidden=false;status.textContent=`已读取${table.rows.length}行、${table.headers.length}列，请核对字段后分析。`;}catch(error){status.textContent=error instanceof Error?error.message:'文件无法读取。';}};
  let importRevision=0;
  file.addEventListener('change',async()=>{const revision=++importRevision;table=null;observations=[];results.hidden=true;mappingSection.hidden=true;const selected=file.files?.[0];if(!selected)return;try{if(selected.size>5_000_000)throw Error('文件超过5MB，请缩小导出范围。');const text=await selected.text();if(revision===importRevision)readCsv(text);}catch(error){if(revision===importRevision)status.textContent=error instanceof Error?error.message:'文件无法读取。';}});
  document.querySelector('#read-pasted-csv')!.addEventListener('click',()=>{importRevision++;file.value='';readCsv(document.querySelector<HTMLTextAreaElement>('#search-csv-paste')!.value);});
  document.querySelector('#clear-search-data')!.addEventListener('click',clear);
  document.querySelector('#analyze-search-data')!.addEventListener('click',()=>{results.hidden=true;observations=[];try{if(!table)throw Error('请先导入CSV。');const mapping=Object.fromEntries(keys.map(key=>[key,Number(document.querySelector<HTMLSelectElement>('#map-'+key)!.value)])) as unknown as ReviewMapping;const minimum=document.querySelector<HTMLInputElement>('#review-minimum')!.value;const ctr=document.querySelector<HTMLInputElement>('#review-ctr')!.value;if(!minimum.trim()||!ctr.trim())throw Error('请填写筛选参考线。');settings={minimumImpressions:Number(minimum),targetCtr:Number(ctr)/100};observations=observationsFromCsv(table,mapping);observations.forEach(row=>reviewRecommendation(row,settings));observations.sort((a,b)=>reviewRecommendation(a,settings).priority-reviewRecommendation(b,settings).priority||b.impressions-a.impressions);const sum=observations.reduce((s,row)=>({impressions:s.impressions+row.impressions,clicks:s.clicks+row.clicks}),{impressions:0,clicks:0});const summary=document.querySelector('#search-summary')!;summary.replaceChildren();for(const [label,value]of [['导入数据行',String(observations.length)],['导入行合计展现',String(sum.impressions)],['导入行合计点击',String(sum.clicks)]]){const block=document.createElement('div');const strong=document.createElement('strong');strong.textContent=value;const text=document.createElement('span');text.textContent=label;block.append(strong,text);summary.append(block);}const body=document.querySelector('#search-results-body')!;body.replaceChildren();for(const row of observations.slice(0,100)){const tr=document.createElement('tr');const first=document.createElement('th');first.scope='row';first.textContent=row.query||row.page;const matched=targets.find(target=>normalize(target.keyword)===normalize(row.query));const page=row.page||(matched?'https://jichangtuijian.rest'+matched.path:'');if(page){const a=document.createElement('a');a.href=page;a.target='_blank';a.rel='noopener noreferrer';a.textContent=' 打开目标页 ↗';first.append(document.createElement('br'),a);}tr.append(first);for(const value of [String(row.impressions),String(row.clicks),row.ctr===null?'无展现':(row.ctr*100).toFixed(2)+'%',row.position===null?'未提供':String(row.position)]){const cell=document.createElement('td');cell.textContent=value;tr.append(cell);}const recommendation=reviewRecommendation(row,settings);const cell=document.createElement('td');const strong=document.createElement('strong');strong.textContent=recommendation.action;const p=document.createElement('p');p.textContent=recommendation.reason;cell.append(strong,p);tr.append(cell);body.append(tr);}results.hidden=false;document.querySelector('#search-results-status')!.textContent=`按当前参考线分析${observations.length}行，显示前${Math.min(observations.length,100)}行；下载包含全部建议。合计仅覆盖导入行，不代表站点所有搜索流量。`;status.textContent='分析完成，未修改网站页面或提交URL。';}catch(error){status.textContent=error instanceof Error?error.message:'请检查数据。';}});
  document.querySelector('#export-search-review')!.addEventListener('click',()=>{if(!observations.length)return;const scope=document.querySelector<HTMLInputElement>('#review-scope')!.value;const url=URL.createObjectURL(new Blob([exportReviewCsv(observations,settings,scope)],{type:'text/csv;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download='Bing搜索数据复盘清单.csv';link.click();setTimeout(()=>URL.revokeObjectURL(url),0);});
 </script>
</Base>
