---
import Base from '../layouts/Base.astro';
import FaqSection from '../components/FaqSection.astro';
import {troubleshootingFaq} from '../data/page-faq';
import {faqSchema} from '../lib/faq';
import {troubleshootingPaths,troubleshootingText,supportOutline,troubleshootingUpdated} from '../data/troubleshooting';
---
<Base title="机场连接故障排查中心｜订阅更新、网页打不开、视频卡顿与流量异常" description="按六类症状查找机场与客户端排查路径：订阅更新失败、已连接但打不开、测速快视频卡、单个平台失败、流量统计不同及网络切换断线。每条路径包含五步检查、结果判断、恢复方式和脱敏反馈提纲。" keywords={['机场故障排查','订阅更新失败','已连接但网页打不开','测速快视频卡','流量异常','网络切换断线']} schema={[faqSchema(troubleshootingFaq)]} breadcrumbs={[{name:'故障排查中心',url:'/troubleshooting/'}]}>
 <header class="page-intro"><p class="eyebrow">FIND THE FAILING STEP</p><h1>从现象开始，把问题缩小一步。</h1><p>选一个最接近的症状，沿“检查什么—看到什么—下一步”往下走。先记录条件，再一次只改一个变量。</p><p class="muted">排查内容更新：<time datetime={troubleshootingUpdated}>{troubleshootingUpdated}</time> · 通用检查路径，具体界面按所用客户端说明</p></header>
 <section class="reader-value-intro"><h2>先留住三项信息</h2><p>发生时间与时区、网络和设备/客户端、失败的具体任务。新请求与缓存页面、配置更新与节点连接、网页可达与功能可用，分别记录。保留失败原提示及原设置，后面才能对照恢复动作。</p><div class="case-reading"><a href="/guides/build-network-baseline/">建立网络基线 →</a><a href="/guides/prepare-support-ticket/">怎样整理支持工单 →</a><a href="/comparisons/">还没购买？先读品牌对照 →</a></div></section>
 <nav class="help-quicklinks" aria-label="六类故障症状">{troubleshootingPaths.map((item,index)=><a href={'#'+item.id}><span>0{index+1}</span>{item.title}<b aria-hidden="true">↗</b></a>)}</nav>
 <div class="reader-filter"><label for="help-search">按症状查找路径</label><input type="search" id="help-search" placeholder="例如：更新、视频、流量、切换"/><p id="help-count" role="status" aria-live="polite">共6条路径 · 每条5步</p></div><div class="help-actions"><button type="button" class="quiet-button" id="help-reset">清除筛选</button><button type="button" class="quiet-button" id="help-expand">展开当前路径</button><button type="button" class="quiet-button" id="help-collapse">收起全部路径</button></div>
 <div class="help-paths">{troubleshootingPaths.map((item,index)=><details id={item.id} class="help-path" data-help-search={troubleshootingText(item)} open={index===0}><summary><span class="reader-value-label">0{index+1} / 按症状排查</span><h2>{item.title}</h2><span>{item.description}</span></summary><div class="help-path-body"><h3>先分清当前现象</h3><p>{item.firstCheck}</p><ol class="help-steps">{item.steps.map((step,i)=><li><span class="help-step-number">0{i+1}</span><div><h3>{step.title}</h3><p>{step.action}</p><dl><div><dt>观察结果</dt><dd>{step.observe}</dd></div><div><dt>接下来怎样判断</dt><dd>{step.next}</dd></div></dl></div></li>)}</ol><div class="help-outcome-grid"><section><h3>怎样确认本次结束</h3><p>{item.verify}</p></section><section><h3>怎样恢复临时改动</h3><p>{item.restore}</p></section></div><section><h3>仍未解决时，反馈哪些信息</h3><p>{item.handoff}</p><label class="help-copy-label" for={'help-outline-'+item.id}>可复制的脱敏反馈提纲</label><textarea id={'help-outline-'+item.id} rows="7" readonly>{supportOutline(item)}</textarea><button type="button" class="quiet-button" data-copy-help>复制本路径反馈提纲</button><p class="help-copy-status" role="status" aria-live="polite"></p></section><div class="case-reading">{item.readings.map(link=><a href={link.url}>{link.title} →</a>)}<a href="/contact/">联络站长反馈页面问题 →</a></div></div></details>)}</div>
 <p class="help-no-result" id="help-no-result" hidden>没有匹配路径。试试“更新”“网页”“平台”“流量”，或清除筛选后浏览六类症状。</p>
 <noscript><p>六条路径已完整写入页面，不依赖脚本读取；点击标题展开。筛选和复制需要JavaScript，也可手动选择提纲文字。</p></noscript>
 <FaqSection items={troubleshootingFaq} id="troubleshooting-faq" heading="故障排查常见问题" intro="先看直接答案，再沿链接回到对应的五步路径。"/>
 <section class="reader-value-intro help-footer"><h2>让反馈能被复查，而不是只剩一句“不能用”</h2><p>注明失败任务、时间、设备和只改变一个条件的结果。未知原因保留未知；没有观察到的恢复、额外扣量或平台资格不写成事实。站长可以帮助核对站内资料，套餐结算和品牌支持仍按对应渠道处理。</p><div class="case-reading"><a href="/guides/">查找30篇操作教程 →</a><a href="/airport/">查看具体品牌条件 →</a><a href="/evidence/records/">核对测试环境与原图日期 →</a></div></section>
 <script>
  const helpInput=document.querySelector<HTMLInputElement>('#help-search')!;const paths=[...document.querySelectorAll<HTMLDetailsElement>('[data-help-search]')];const status=document.querySelector<HTMLElement>('#help-count')!;
  const update=()=>{const query=helpInput.value.trim().toLowerCase().replace(/\s+/g,'');const matched=paths.filter(path=>{path.hidden=!path.dataset.helpSearch!.replace(/\s+/g,'').includes(query);return !path.hidden;});if(query&&matched.length===1)matched[0].open=true;status.textContent=query?`找到${matched.length}条路径`:'共6条路径 · 每条5步';document.querySelector<HTMLElement>('#help-no-result')!.hidden=matched.length>0;};
  helpInput.addEventListener('input',update);document.querySelector('#help-reset')!.addEventListener('click',()=>{helpInput.value='';update();});document.querySelector('#help-expand')!.addEventListener('click',()=>paths.filter(path=>!path.hidden).forEach(path=>path.open=true));document.querySelector('#help-collapse')!.addEventListener('click',()=>paths.forEach(path=>path.open=false));
  const revealHash=()=>{let id='';try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}const path=paths.find(p=>p.id===id);if(path){helpInput.value='';update();path.open=true;path.scrollIntoView({block:'start'});}};window.addEventListener('hashchange',revealHash);revealHash();
  document.querySelectorAll<HTMLButtonElement>('[data-copy-help]').forEach(button=>button.addEventListener('click',async()=>{const path=button.closest<HTMLDetailsElement>('.help-path')!;const text=path.querySelector<HTMLTextAreaElement>('textarea')!;const message=path.querySelector<HTMLElement>('.help-copy-status')!;try{await navigator.clipboard.writeText(text.value);message.textContent='已复制该路径的反馈提纲，请在发送前填写并检查脱敏。';}catch{text.focus();text.select();message.textContent='自动复制未完成，提纲已选中，可手动复制。';}}));
 </script>
</Base>
