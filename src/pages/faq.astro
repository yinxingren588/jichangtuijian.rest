---
import Base from '../layouts/Base.astro';
import FaqSection from '../components/FaqSection.astro';
import {generalFaq,faqUpdated} from '../data/page-faq';
import {faqSchema} from '../lib/faq';
const categories=[...new Set(generalFaq.map(q=>q.category))];
---
<Base title="机场常见问题FAQ｜套餐流量、优惠码、节点测速与连接帮助" description="集中解答机场选择、月付年付、流量预算、永久优惠、结算凭据、站长测速、节点权限与客户端故障的12个常见问题。每条回答链接到品牌、实测、对照或操作教程，继续核对具体条件。" keywords={['机场FAQ','机场常见问题','机场套餐流量','机场优惠码','节点测速问题','订阅连接帮助']} schema={[faqSchema(generalFaq)]} breadcrumbs={[{name:'常见问题FAQ',url:'/faq/'}]}>
 <header class="page-intro"><p class="eyebrow">A CLEAR ANSWER, THEN THE DETAILS</p><h1>先找到答案，再把细节核对清楚。</h1><p>从选择与预算，到优惠、测速和连接问题。通用答案放在这里，各品牌和具体对照页保留自己的专属问答。</p><p class="muted">问答维护：<time datetime={faqUpdated}>{faqUpdated}</time> · 不代替品牌当前结算与实际任务验证</p></header>
 <div class="faq-toolbar"><label>搜索常见问题<input id="faq-search" type="search" placeholder="例如：优惠、月付、测速、连接"/></label><label>问题分类<select id="faq-category"><option value="">全部分类</option>{categories.map(category=><option value={category}>{category}</option>)}</select></label><button type="button" class="quiet-button" id="faq-reset">清除筛选</button></div><p class="faq-status" id="faq-status" role="status" aria-live="polite">共12个常见问题</p>
 <FaqSection items={generalFaq} id="general-faq" heading="选择、付款、测速与使用问答" intro="展开阅读直接答案，再沿每条下方的入口查看对应资料。没有确认的金额、权限和环境参数保持待核对。" filterable/>
 <p id="faq-empty" class="faq-empty" hidden>没有匹配问题，请换一个短词或清除筛选。品牌名称、套餐与代码可在站内搜索继续查找。</p>
 <section class="faq-next"><h2>还需要哪一类帮助？</h2><div class="faq-entry-grid"><a href="/airport/"><strong>28个品牌专属问答</strong><span>每家6条，结合自己的套餐、优惠与原图阅读。</span></a><a href="/comparisons/"><strong>五组品牌对照问答</strong><span>逐篇解答付款模型、容量与节点选择的差别。</span></a><a href="/troubleshooting/#troubleshooting-faq"><strong>连接故障问答</strong><span>按六类症状继续查看检查步骤与恢复方法。</span></a><a href="/contact/"><strong>联络站长补充问题</strong><span>附对应页面与脱敏描述，方便核对资料。</span></a></div></section>
 <noscript><p>全部问答已完整写入页面，可手动展开阅读；筛选需要JavaScript，也可使用浏览器查找。</p></noscript>
 <script>
  const query=document.querySelector<HTMLInputElement>('#faq-search')!;const category=document.querySelector<HTMLSelectElement>('#faq-category')!;const items=[...document.querySelectorAll<HTMLDetailsElement>('[data-faq-search]')];
  const update=()=>{const term=query.value.trim().toLowerCase().replace(/\s+/g,'');const matched=items.filter(item=>{item.hidden=(!item.dataset.faqSearch!.replace(/\s+/g,'').includes(term))||Boolean(category.value&&category.value!==item.dataset.faqCategory);return !item.hidden;});if(matched.length===1)matched[0].open=true;document.querySelector('#faq-status')!.textContent=term||category.value?`显示${matched.length}个问题`:'共12个常见问题';document.querySelector<HTMLElement>('#faq-empty')!.hidden=matched.length>0;};
  query.addEventListener('input',update);category.addEventListener('change',update);document.querySelector('#faq-reset')!.addEventListener('click',()=>{query.value='';category.value='';update();});
  const reveal=()=>{let id='';try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}const item=items.find(item=>item.id===id);if(item){query.value='';category.value='';update();item.open=true;item.scrollIntoView({block:'start'});}};window.addEventListener('hashchange',reveal);reveal();
 </script>
</Base>
