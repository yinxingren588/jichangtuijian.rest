---
import {getCollection,render} from 'astro:content';
import Base from '../layouts/Base.astro';
import BrandCard from '../components/BrandCard.astro';
import RankingTable from '../components/RankingTable.astro';
import {rankBrands,type Ranking} from '../data/ranking';
import {airports,airportCandidates} from '../data/airports';
import {topics,site} from '../data/site';
import {policies} from '../data/policies';
export async function getStaticPaths(){
 const articles=await getCollection('articles',a=>!a.data.draft);
 const paths=[...['recommend','ranking','airport','review','guides','blog','glossary'].map(path=>({params:{path},props:{mode:'index',slug:path}})),...topics.map(t=>({params:{path:'recommend/'+t.slug},props:{mode:'topic',slug:t.slug}})),...['overall','value','budget','stable'].map(slug=>({params:{path:'ranking/'+slug},props:{mode:'ranking',slug}})),...airports.map(a=>({params:{path:'airport/'+a.slug},props:{mode:'brand',slug:a.slug}})),...policies.map(p=>({params:{path:p.slug},props:{mode:'policy',slug:p.slug}})),...articles.map(a=>({params:{path:a.data.section+'/'+a.id},props:{mode:'article',slug:a.id}}))];return paths;
}
const {mode,slug}=Astro.props;
const articles=await getCollection('articles',a=>!a.data.draft);
const topic=topics.find(t=>t.slug===slug);
const brand=airports.find(a=>a.slug===slug);
const policy=policies.find(p=>p.slug===slug);
const article=articles.find(a=>a.id===slug);
const labels:Record<string,string>={recommend:'机场推荐专题',ranking:'机场排行榜',airport:'品牌资料库',review:'独立评测与方法',guides:'使用教程',blog:'选择指南与博客',glossary:'知识百科'};
const rankNames:Record<string,string>={overall:'综合排行榜',value:'性价比排行榜',budget:'低预算排行榜',stable:'稳定性排行榜'};
const rankRules:Record<string,string>={overall:'综合榜本期仅按资料透明度排序：已核实月付套餐、协议、地区、设备限制各 1 项，共 0–4 项，不评价速度或稳定性。身份必须先核实，金额不跨币种混排。',value:'只比较同币种月付套餐，实际可用流量 = 标示流量 ÷ 倍率，每 GB 单价 = 月付金额 ÷ 实际可用流量。年付、不限时、无限量及未核实套餐不参加月付排序。',budget:'仅按同币种月付实付金额从低到高排列，不将年付折算月价混入；并列金额共享名次，不以低价推断稳定性。',stable:'需要多时段、固定环境和原始记录，分别公开失败率、延迟分布与恢复时间。单次测速或官方线路宣传不能成为稳定性名次依据。'};
const intro:Record<string,string>={recommend:'按预算、设备和使用目标建立自己的候选清单。每个专题回答一种选择问题，避免把不同需求挤进同一份推荐。',ranking:'四种排序口径，四套证据要求。没有达到核验条件的数据不参与排名，也不使用 VPN 条件替代订阅机场的体验。',airport:'当前收录 5 家商业 VPN 的部分官方资料，订阅机场身份仍待核验。档案按名称展示，不代表推荐顺序；价格与能力只对已引用字段负责。',review:'本期尚未发布独立实测。这里公开评测标准和数据边界，品牌资料只代表公开信息整理，不写成亲测体验。',guides:'从安装来源、权限到连接验证，一步步建立可排查的使用流程。适用于了解网络连接工具，不替代具体客户端的最新官方文档。',blog:'把购买和使用问题拆开：计算真实成本、核对线路证据、记录稳定性，避免用宣传结论替代自己的判断。',glossary:'先弄清协议、订阅、流量和网络指标，再读懂套餐说明。每篇词条解释一个概念，并链接到实际检查流程。'};
const title=mode==='article'?article!.data.title:mode==='topic'?topic!.name+'机场怎么选：'+topic!.lead:mode==='ranking'?rankNames[slug]+'：方法与数据状态':mode==='brand'?brand!.name+' VPN 资料与套餐条件':mode==='policy'?policy!.title:labels[slug];
const description=mode==='article'?article!.data.description:mode==='topic'?topic!.text:mode==='ranking'?rankRules[slug]:mode==='brand'?brand!.description:mode==='policy'?policy!.description:intro[slug];
const parent=mode==='topic'?'recommend':mode==='ranking'?'ranking':mode==='brand'?'airport':mode==='article'?article!.data.section:'';
const breadcrumbs=[...(parent?[{name:labels[parent],url:'/'+parent+'/'}]:[]),{name:title,url:Astro.url.pathname}];
const rankRows=mode==='ranking'?rankBrands(slug as Ranking):[];
const schema=mode==='article'?[{'@type':article!.data.section==='blog'?'BlogPosting':'Article',headline:title,description,datePublished:article!.data.published,dateModified:article!.data.updated,inLanguage:'zh-CN',author:{'@type':'Organization',name:site.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).href}]:mode==='index'&&slug==='airport'?[{'@type':'ItemList',name:'商业 VPN 公开资料档案（非排名）',itemListElement:airports.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:site.url+'/airport/'+a.slug+'/'}))}]:[];
const rendered=mode==='article'?await render(article!):null;
const Content=rendered?.Content;
const list=articles.filter(a=>a.data.section===slug);
---
<Base title={title} description={description} noindex={mode==='ranking'} breadcrumbs={breadcrumbs} schema={schema}>
<header class="page-intro"><p class="eyebrow">{mode==='article'?'FIELD NOTES / 实用知识':mode==='brand'?'VERIFIED FIELDS / 公开资料':'CONNECTION GUIDE / 航线笔记'}</p><h1>{title}</h1><p>{description}</p><p class="muted">{mode==='article'?`发布 ${article!.data.published} · 更新 ${article!.data.updated} · 站点维护者整理`:'资料与页面更新：2026-10-23'}</p></header>
{mode==='article'&&Content&&<div class="article-layout"><article class="prose"><Content/><h2>来源与核验范围</h2><p>以下为参考原始资料。品牌价格和功能应以资料库对应字段为准；本文不包含品牌测速或使用体验。内容由站点维护者使用 AI 辅助整理，尚不构成独立实测。</p><ul class="sources">{article!.data.sources.map((s:string)=><li><a href={s} target="_blank" rel="noopener noreferrer">{new URL(s).hostname} · 原始资料 ↗</a></li>)}</ul></article><aside class="sidebar card"><h2 class="text-lg font-bold text-ink">本文目录</h2>{rendered?.headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}<h2 class="text-lg font-bold text-ink">相关内容</h2>{articles.filter(a=>a.id!==slug&&a.data.tags.some(t=>article!.data.tags.includes(t))).slice(0,4).map(a=><a href={'/'+a.data.section+'/'+a.id+'/'}>{a.data.title}</a>)}<a href="/recommend/">按需求选择 →</a></aside></div>}
{mode==='policy'&&<article class="prose max-w-[820px]">{policy!.blocks.map(([h,p])=><><h2>{h}</h2><p>{p}</p></>)}{slug==='contact'&&<p><a href={site.repository+'/issues'} target="_blank" rel="noopener noreferrer">前往项目 Issues 提交反馈 ↗</a></p>}<p><a href="/editorial-policy/">查看编辑政策</a> · <a href="/contact/">联系与纠错</a></p></article>}
{mode==='topic'&&<><section><div class="grid">{topic!.checks.map((c,i)=><article class="card"><span class="number">CHECK 0{i+1}</span><h2>{c}</h2><p>核对当前条款、来源和适用范围，保留能够复核的记录。资料不足时暂不做购买结论。</p></article>)}</div></section><section class="article-layout"><article class="prose"><h2>快速结论</h2><p>{topic!.text}</p><h2>怎样建立候选清单</h2><p>先列出设备、网络、使用时段、每月用量和预算，再检查服务的身份、套餐周期、流量倍率和退款条件。把已核实的项目与待确认项分别记录；没有来源的功能不应计入比较优势。</p><h2>当前推荐状态</h2><p>尚无身份及套餐完成核验的订阅机场候选。本站不据同名搜索结果直接认定官网。商业 VPN 的公开档案单列在资料库，不代表机场榜单。</p><p><a href={'/blog/'+topic!.article+'/'}>继续阅读相关选择指南</a> · <a href="/ranking/">查看排名口径</a> · <a href="/compare/">打开比较工具</a></p></article><aside class="card sidebar"><h2 class="text-lg font-bold">其他需求</h2>{topics.filter(t=>t.slug!==slug).map(t=><a href={'/recommend/'+t.slug+'/'}>{t.name} →</a>)}</aside></section></>}
{mode==='ranking'&&<><div class="note">暂停发布名次 · 当前合格机场样本 {airportCandidates.length} 家。此页设置 noindex，并从 Sitemap 排除，待资料满足本页标准后再开放索引。</div><article class="prose max-w-[820px]"><h2>快速结论</h2><p>当前不能根据本站数据给出可核验的机场名次。先参考<a href="/blog/buying-checklist/">购买清单</a>筛选条件，再提交可靠的品牌来源。</p><h2>排名依据</h2><p>{rankRules[slug]}</p><h2>比较表与品牌简介</h2><RankingTable kind={slug as Ranking}/>{rankRows.map(r=><><h3>{r.brand.name}</h3><p>{r.brand.description} 适合：{r.brand.suitableFor.join("、")}</p><p><a href={"/airport/"+r.brand.slug+"/"}>品牌资料与来源</a></p></>)}<h2>适合人群</h2><p>希望了解{rankNames[slug]}评价方式、愿意核对原始资料的读者。所有排名只对公开方法与样本范围负责，不保证未来表现。</p><h2>评测与比较</h2><p><a href="/review/">独立评测证据要求</a> · <a href="/compare/">横向比较工具</a></p><h2>数据来源与更新时间</h2><p>本榜暂无已核验机场来源，未使用商业 VPN 数据补位。方法更新于 2026-10-23。录入机场时必须补充身份依据、套餐原始来源与核验日期。</p></article></>}
{mode==='brand'&&<><div class="note">商业 VPN · 官方资料整理 · 未实测。该档案不属于订阅机场评测，未验证特定网络、AI 或流媒体可用性。</div><div class="article-layout"><article class="prose"><h2>一句话结论</h2><p>{brand!.description}</p><h2>基本介绍</h2><p>{brand!.name} 的以下字段来自所列官方页面，资料核验日 {brand!.lastVerified}。官网可读不表示连接质量已经测试。</p><h2>套餐条件</h2><div class="table-wrap"><table><thead><tr><th scope="col">方案</th><th scope="col">实付 / 周期</th><th scope="col">流量 / 倍率</th></tr></thead><tbody>{brand!.plans.length?brand!.plans.map(p=><tr><td>{p.name}</td><td>{p.currency} {p.price} / {p.period==='month'?'月付':p.period==='free'?'免费方案':'其他周期'}</td><td>{p.unlimited?'官方不限流量':p.trafficGB?p.trafficGB+' GB（重置周期尚未核实）':'尚未核实'}；倍率 {p.multiplier}</td></tr>):<tr><td colspan="3">套餐价格与额度尚未核实</td></tr>}</tbody></table></div><p>免费方案不参与月付性价比排序。税费、账户资格及结算条件请在官方渠道再次确认。</p><h2>节点与协议</h2><p>地区：{brand!.regions.join('、')||'尚未核实'}。协议：{brand!.protocols.join('、')||'尚未核实'}。线路类型：尚未核实。</p><h2>客户端与设备限制</h2><p>{brand!.deviceLimit||'尚未核实'}。下载仅通过官方页面进入；各平台版本与功能差异需再次确认。</p><h2>AI 与流媒体支持</h2><p>尚未核实。没有进行账号、地区、设备或具体平台的连接测试，不据供应商宣传作长期承诺。</p><h2>资料中的优势</h2><ul>{brand!.advantages.map(t=><li>{t}</li>)}</ul><h2>注意事项与缺点</h2><ul>{brand!.disadvantages.map(t=><li>{t}</li>)}</ul><h2>适合人群</h2><p>{brand!.suitableFor.join('、')}。这是基于条款的阅读建议，不是实际体验推荐。</p><h2>购买前检查</h2><p>核对套餐周期、税费、自动续费和退款限制，先验证自己的网络环境。阅读<a href="/blog/buying-checklist/">完整购买清单</a>。</p><h2>常见问题</h2><h3>这是实测评测吗？</h3><p>不是。当前状态为官方资料，速度、稳定性、解锁与隐私实现均未独立测试。</p><h3>能与机场直接比较吗？</h3><p>应先区分类别、配置方式、同币种价格和同周期额度，不能把商业 VPN 等同于代理订阅机场。</p><h2>来源与核验日期</h2><p>最后字段核验：{brand!.lastVerified}。官方资料可能变化。</p><ul class="sources">{brand!.sources.map(s=><li><a href={s} target="_blank" rel="noopener noreferrer">{s}</a></li>)}</ul></article><aside class="sidebar card"><h2 class="text-lg font-bold">继续比较</h2><a href={'/compare/?brands='+brand!.slug}>加入横向比较 →</a><a href="/review/">了解独立评测标准</a><a href="/editorial-policy/">数据与编辑政策</a><a href="/contact/">报告资料错误</a></aside></div></>}
{mode==='index'&&slug==='recommend'&&<section><div class="grid">{topics.map((t,i)=><a class="card" href={'/recommend/'+t.slug+'/'}><span class="number">0{i+1} / 选择路径</span><h2>{t.name} ↗</h2><p>{t.lead}</p><p>{t.text}</p></a>)}</div></section>}
{mode==='index'&&slug==='ranking'&&<section><div class="grid four">{Object.entries(rankNames).map(([s,n])=><a href={'/ranking/'+s+'/'} class="card"><span class="tag neutral">等待核验样本</span><h2>{n}</h2><p>{rankRules[s]}</p><span class="text-link">查看方法 →</span></a>)}</div><div class="note">目前没有已发布的机场名次。不要将资料的展示顺序理解为推荐等级。</div><a class="text-link" href="/editorial-policy/">阅读完整编辑与排序政策 →</a></section>}
{mode==='index'&&slug==='airport'&&<section><div class="grid">{airports.map(a=><BrandCard brand={a}/>)}</div><div class="note">订阅机场资料仍待核验；如果能提供可靠身份依据和原始套餐页面，请通过<a href="/contact/">纠错渠道</a>提交。</div></section>}
{mode==='index'&&slug==='review'&&<article class="prose max-w-[820px]"><h2>当前没有独立实测文章</h2><p>本期只整理公开资料。未购买套餐、未记录网络环境和多时段原始结果，因此不发布速度、稳定性或解锁结论。</p><h2>一篇评测需要哪些证据</h2><ol><li>核实品牌身份、套餐金额、周期、流量和线路范围。</li><li>记录设备、客户端版本、协议、本地运营商与测试目标。</li><li>覆盖不同时间段，保留成功和失败样本。</li><li>分别讨论吞吐、延迟、抖动、失败率与恢复时间。</li><li>公开来源、测试局限、利益关系和最后核验日期。</li></ol><h2>官方资料与实测如何区分</h2><p>官方页面的参数属于公开声明。编辑可以解释它们，但不能将声明改写为亲测。未知字段保持未知；评测模板已经预留，证据不足时不生成品牌评测页。</p><p><a href="/blog/stability-method/">查看可复核的稳定性记录方法</a> · <a href="/airport/">阅读品牌资料档案</a> · <a href="/compare/">比较已核实字段</a></p></article>}
{mode==='index'&&['guides','blog','glossary'].includes(slug)&&<section><div class="grid">{list.map(a=><article class="card article-card"><span class="tag neutral">{a.data.updated} · {labels[slug]}</span><h2><a href={'/'+a.data.section+'/'+a.id+'/'}>{a.data.title}</a></h2><p>{a.data.description}</p><a class="text-link" href={'/'+a.data.section+'/'+a.id+'/'}>阅读全文 ↗</a></article>)}</div></section>}
</Base>
