---
import {getCollection,render} from 'astro:content';
import Base from '../layouts/Base.astro';
import BrandCard from '../components/BrandCard.astro';
import BrandDirectory from '../components/BrandDirectory.astro';
import BrandProfile from '../components/BrandProfile.astro';
import ContentDirectory from '../components/ContentDirectory.astro';
import {relatedEntries,categoryFor,categoryUrl,readingMinutes} from '../lib/content';
import ArticleJourney from '../components/ArticleJourney.astro';
import {brandEditorials} from '../data/brand-editorials';
import RankingTable from '../components/RankingTable.astro';
import {rankBrands,type Ranking} from '../data/ranking';
import {airports,airportCandidates,partnerAirports} from '../data/airports';
import {topics,site} from '../data/site';
import {policies} from '../data/policies';
export async function getStaticPaths(){
 const articles=await getCollection('articles',a=>!a.data.draft);
 const paths=[...['recommend','ranking','airport','review','guides','blog','glossary'].map(path=>({params:{path},props:{mode:'index',slug:path}})),...topics.map(t=>({params:{path:'recommend/'+t.slug},props:{mode:'topic',slug:t.slug}})),...['overall','value','budget','stable'].map(slug=>({params:{path:'ranking/'+slug},props:{mode:'ranking',slug}})),...airports.map(a=>({params:{path:'airport/'+a.slug},props:{mode:'brand',slug:a.slug}})),...policies.map(p=>({params:{path:p.slug},props:{mode:'policy',slug:p.slug}})),...articles.map(a=>({params:{path:a.data.section+'/'+a.id},props:{mode:'article',slug:a.id}}))];return paths;
}
const {mode,slug}=Astro.props;
const articles=await getCollection('articles',a=>!a.data.draft);
const topic=topics.find(t=>t.slug===slug);
const brand=airports.find(a=>a.slug===slug);
const policy=policies.find(p=>p.slug===slug);
const article=articles.find(a=>a.id===slug);
const labels:Record<string,string>={recommend:'机场推荐专题',ranking:'机场排行榜',airport:'品牌资料库',review:'独立评测与方法',guides:'使用教程',blog:'知识文章',glossary:'知识百科'};
const rankNames:Record<string,string>={overall:'综合排行榜',value:'性价比排行榜',budget:'低预算排行榜',stable:'稳定性排行榜'};
const rankRules:Record<string,string>={overall:'综合榜本期仅按资料透明度排序：已核实月付套餐、协议、地区、设备限制各 1 项，共 0–4 项，不评价速度或稳定性。身份必须先核实，金额不跨币种混排。',value:'只比较同币种月付套餐，实际可用流量 = 标示流量 ÷ 倍率，每 GB 单价 = 月付金额 ÷ 实际可用流量。年付、不限时、无限量及未核实套餐不参加月付排序。',budget:'仅按同币种月付实付金额从低到高排列，不将年付折算月价混入；并列金额共享名次，不以低价推断稳定性。',stable:'需要多时段、固定环境和原始记录，分别公开失败率、延迟分布与恢复时间。单次测速或官方线路宣传不能成为稳定性名次依据。'};
const intro:Record<string,string>={recommend:'按预算、设备和使用目标建立自己的候选清单。每个专题回答一种选择问题，避免把不同需求挤进同一份推荐。',ranking:'四种排序口径，四套证据要求。没有达到核验条件的数据不参与排名，也不使用 VPN 条件替代订阅机场的体验。',airport:'收录 28 家机场的 56 档参考套餐和 12 个维护者提供的优惠码；另保留 5 家商业 VPN 官方资料。价格与流量来自指定参考站，不把来源整理当作独立实测。',review:'已收录维护者提供的测速与解锁图，尚未独立复测。这里公开评测标准、测试环境要求及图表资料与独立体验的区别。',guides:'30 篇教程按 Windows、Android、iOS、macOS 和通用任务分组，包含准备、步骤、结果验证与恢复方法；具体界面以当前官方文档为准。',blog:'200 篇知识文章覆盖预算、流量、节点、网络原理、性能、隐私、设备、应用、账户与证据方法。按分类或分页找到当前问题，再沿相关教程继续操作。',glossary:'先弄清协议、订阅、流量和网络指标，再读懂套餐说明。每篇词条解释一个概念，并链接到实际检查流程。'};
const title=mode==='article'?article!.data.title:mode==='topic'?topic!.name+'机场怎么选：'+topic!.lead:mode==='ranking'?rankNames[slug]+'：方法与数据状态':mode==='brand'?brand!.name+(brand!.kind==='vpn'?' VPN 资料与套餐条件':'机场套餐、价格、流量与优惠码'):mode==='policy'?policy!.title:labels[slug];
const description=mode==='article'?article!.data.description:mode==='topic'?topic!.text:mode==='ranking'?rankRules[slug]:mode==='brand'?brandEditorials[brand!.slug].summary:mode==='policy'?policy!.description:intro[slug];
const parent=mode==='topic'?'recommend':mode==='ranking'?'ranking':mode==='brand'?'airport':mode==='article'?article!.data.section:'';
const breadcrumbs=[...(parent?[{name:labels[parent],url:'/'+parent+'/'}]:[]),{name:title,url:Astro.url.pathname}];
const rankRows=mode==='ranking'?rankBrands(slug as Ranking):[];
const schema=mode==='article'?[{'@type':article!.data.section==='blog'?'BlogPosting':'Article',headline:title,description,datePublished:article!.data.published,dateModified:article!.data.updated,inLanguage:'zh-CN',author:{'@type':'Organization',name:site.name},mainEntityOfPage:new URL(Astro.url.pathname,site.url).href}]:mode==='index'&&slug==='airport'?[{'@type':'ItemList',name:'机场与 VPN 品牌资料档案（非排名）',itemListElement:airports.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:site.url+'/airport/'+a.slug+'/'}))}]:[];
const rendered=mode==='article'?await render(article!):null;
const Content=rendered?.Content;
const related=mode==='article'?relatedEntries(article!,articles):[];
---
<Base title={title} description={description} noindex={mode==='ranking'} breadcrumbs={breadcrumbs} schema={schema}>
<header class="page-intro"><p class="eyebrow">{mode==='article'?'FIELD NOTES / 实用知识':mode==='brand'?'BRAND RECORD / 价格与条款':'CONNECTION GUIDE / 航线笔记'}</p><h1>{title}</h1><p>{description}</p><p class="muted">{mode==='article'?`发布 ${article!.data.published} · 更新 ${article!.data.updated} · ${categoryFor(article!)} · AI 辅助整理`:'资料与页面更新：2026-10-23'}</p></header>
{mode==='article'&&Content&&<div class="article-layout"><div class="reading-main"><div class="reading-context"><a href={categoryUrl(article!)}>{categoryFor(article!)} ↗</a><span>约 {readingMinutes(article!)} 分钟阅读</span><a href="#reading-navigation">上一篇 / 下一篇 ↓</a><a href="#continue-reading">延伸阅读 ↓</a></div><details class="mobile-toc"><summary>本文目录 · {rendered?.headings.filter(h=>h.depth===2).length} 个章节</summary><nav aria-label="手机文章目录">{rendered?.headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></details><article class="prose"><Content/><h2>来源与核验范围</h2><p>以下为参考原始资料。品牌价格和功能应以资料库对应字段为准；本文不包含品牌测速或使用体验。内容由站点维护者使用 AI 辅助整理，尚不构成独立实测。</p><ul class="sources">{article!.data.sources.map((s:string)=><li><a href={s} target="_blank" rel="noopener noreferrer">{new URL(s).hostname} · 原始资料 ↗</a></li>)}</ul></article><ArticleJourney current={article!} entries={articles} related={related}/></div><aside class="sidebar card"><h2 class="text-lg font-bold text-ink">本文目录</h2>{rendered?.headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}<h2 class="text-lg font-bold text-ink">继续阅读</h2><a href="#continue-reading">相关知识与操作教程 →</a><a href={categoryUrl(article!)}>返回 {categoryFor(article!)} →</a><a href="/recommend/">按需求选择 →</a><a href="/airport/">品牌资料与套餐 →</a></aside></div>}
{mode==='policy'&&<article class="prose max-w-[820px]">{policy!.blocks.map(([h,p])=><><h2>{h}</h2><p>{p}</p></>)}{slug==='contact'&&<p><a href={site.repository+'/issues'} target="_blank" rel="noopener noreferrer">前往项目 Issues 提交反馈 ↗</a></p>}<p><a href="/editorial-policy/">查看编辑政策</a> · <a href="/contact/">联系与纠错</a></p></article>}
{mode==='topic'&&<><section><div class="grid">{topic!.checks.map((c,i)=><article class="card"><span class="number">CHECK 0{i+1}</span><h2>{c}</h2><p>核对当前条款、来源和适用范围，保留能够复核的记录。资料不足时暂不做购买结论。</p></article>)}</div></section><section class="article-layout"><article class="prose"><h2>快速结论</h2><p>{topic!.text}</p><h2>怎样建立候选清单</h2><p>先列出设备、网络、使用时段、每月用量和预算，再检查服务的身份、套餐周期、流量倍率和退款条件。把已核实的项目与待确认项分别记录；没有来源的功能不应计入比较优势。</p><h2>当前推荐状态</h2><p>尚无身份及套餐完成核验的订阅机场候选。本站不据同名搜索结果直接认定官网。商业 VPN 的公开档案单列在资料库，不代表机场榜单。</p><p><a href={'/blog/'+topic!.article+'/'}>继续阅读相关选择指南</a> · <a href="/ranking/">查看排名口径</a> · <a href="/compare/">打开比较工具</a></p></article><aside class="card sidebar"><h2 class="text-lg font-bold">其他需求</h2>{topics.filter(t=>t.slug!==slug).map(t=><a href={'/recommend/'+t.slug+'/'}>{t.name} →</a>)}</aside></section></>}
{mode==='ranking'&&<><div class="note">暂停发布名次 · 当前合格机场样本 {airportCandidates.length} 家。此页设置 noindex，并从 Sitemap 排除，待资料满足本页标准后再开放索引。</div><article class="prose max-w-[820px]"><h2>快速结论</h2><p>当前不能根据本站数据给出可核验的机场名次。先参考<a href="/blog/buying-checklist/">购买清单</a>筛选条件，再提交可靠的品牌来源。</p><h2>排名依据</h2><p>{rankRules[slug]}</p><h2>比较表与品牌简介</h2><RankingTable kind={slug as Ranking}/>{rankRows.map(r=><><h3>{r.brand.name}</h3><p>{r.brand.description} 适合：{r.brand.suitableFor.join("、")}</p><p><a href={"/airport/"+r.brand.slug+"/"}>品牌资料与来源</a></p></>)}<h2>适合人群</h2><p>希望了解{rankNames[slug]}评价方式、愿意核对原始资料的读者。所有排名只对公开方法与样本范围负责，不保证未来表现。</p><h2>评测与比较</h2><p><a href="/review/">独立评测证据要求</a> · <a href="/compare/">横向比较工具</a></p><h2>数据来源与更新时间</h2><p>本榜暂无已核验机场来源，未使用商业 VPN 数据补位。方法更新于 2026-10-23。录入机场时必须补充身份依据、套餐原始来源与核验日期。</p></article></>}
{mode==='brand'&&<BrandProfile brand={brand!} entries={articles}/>}
{mode==='index'&&slug==='recommend'&&<section><div class="grid">{topics.map((t,i)=><a class="card" href={'/recommend/'+t.slug+'/'}><span class="number">0{i+1} / 选择路径</span><h2>{t.name} ↗</h2><p>{t.lead}</p><p>{t.text}</p></a>)}</div></section>}
{mode==='index'&&slug==='ranking'&&<section><div class="grid four">{Object.entries(rankNames).map(([s,n])=><a href={'/ranking/'+s+'/'} class="card"><span class="tag neutral">等待核验样本</span><h2>{n}</h2><p>{rankRules[s]}</p><span class="text-link">查看方法 →</span></a>)}</div><div class="note">目前没有已发布的机场名次。不要将资料的展示顺序理解为推荐等级。</div><a class="text-link" href="/editorial-policy/">阅读完整编辑与排序政策 →</a></section>}
{mode==='index'&&slug==='airport'&&<><div class="note">商业披露：机场品牌使用维护者提供的推广链接，本站可能获得佣金。优惠码未验证，不自动计算折后价。套餐资料来源于节点推荐网对应品牌页面。</div><section><div class="section-head"><div><p class="eyebrow">BRAND INDEX / 品牌索引</p><h2>机场品牌 · {partnerAirports.length} 家</h2></div><a class="text-link" href="/compare/">打开比较工具 ⇄</a></div><BrandDirectory/></section><section><div class="section-head"><div><h2>商业 VPN · 独立类别</h2><p>以下为原有 VPN 公开资料，与机场订阅分别呈现。</p></div></div><div class="grid">{airports.filter(a=>a.kind==='vpn').map(a=><BrandCard brand={a}/>)}</div></section></>}
{mode==='index'&&slug==='review'&&<article class="prose max-w-[820px]"><h2>当前没有独立实测文章</h2><p>现已收录维护者提供的 29 组测速与解锁图，包含场景时间、节点记录和平台状态，可前往<a href="/evidence/">图表资料库</a>查看高清原图。本站未独立复测，未取得完整网络环境和原始日志，因此不将提供图表写成独立体验或长期稳定性结论。</p><h2>一篇评测需要哪些证据</h2><ol><li>核实品牌身份、套餐金额、周期、流量和线路范围。</li><li>记录设备、客户端版本、协议、本地运营商与测试目标。</li><li>覆盖不同时间段，保留成功和失败样本。</li><li>分别讨论吞吐、延迟、抖动、失败率与恢复时间。</li><li>公开来源、测试局限、利益关系和最后核验日期。</li></ol><h2>官方资料与实测如何区分</h2><p>官方页面的参数属于公开声明。编辑可以解释它们，但不能将声明改写为亲测。未知字段保持未知；评测模板已经预留，证据不足时不生成品牌评测页。</p><p><a href="/blog/stability-method/">查看可复核的稳定性记录方法</a> · <a href="/airport/">阅读品牌资料档案</a> · <a href="/compare/">比较已核实字段</a></p></article>}
{mode==='index'&&['guides','blog','glossary'].includes(slug)&&<ContentDirectory entries={articles} section={slug as 'guides'|'blog'|'glossary'}/>}
</Base>
