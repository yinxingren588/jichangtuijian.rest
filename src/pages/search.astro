---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {airports} from '../data/airports';
import {brandEditorials} from '../data/brand-editorials';
import {topics} from '../data/site';
import {evidenceFor} from '../data/evidence';
import {categoryFor} from '../lib/content';
const articles=await getCollection('articles',a=>!a.data.draft);
const list=[{title:'流量需求计算器',description:'按视频、会议、文件、使用人数和计费倍率估算每月GB，一键带入月付套餐筛选。',url:'/tools/traffic-calculator/'},{title:'VPN推荐选择指南',description:'按服务类别、套餐、流量和设备要求理解VPN推荐，再沿站内教程与品牌资料核对条件。',url:'/vpn/'},{title:'机场推荐总览',description:'按预算、节点与任务选择，查找品牌套餐、图表与教程。',url:'/'},{title:'品牌测速与流媒体 AI 解锁图表',description:'29组站长原创实测图表，节点速度、场景时间与高清原图。',url:'/evidence/'},{title:'浪网 WaveNet 测速与解锁图',description:'维护者提供的额外品牌图表资料，暂未提供套餐、价格或推广入口。',url:'/evidence/#wavenet'},...articles.map(a=>({title:a.data.title,description:a.data.description+' · '+categoryFor(a),url:'/'+a.data.section+'/'+a.id+'/'})),...airports.map(a=>({title:a.name+(a.kind==='vpn'?' VPN 资料':'机场套餐与优惠码'),description:brandEditorials[a.slug].summary+' '+brandEditorials[a.slug].focus+(evidenceFor(a.slug)?' 附节点测速、流媒体和AI解锁图表。':'')+(a.coupon?' 优惠码 '+a.coupon.code:''),url:'/airport/'+a.slug+'/'})),...topics.map(t=>({title:t.slug==='beginner'?'梯子推荐与新手入门':t.name+'机场选择专题',description:t.text,url:'/recommend/'+t.slug+'/'}))];
---
<Base title="站内搜索" description="在浏览器中搜索教程、选择指南、知识百科和品牌资料。" noindex breadcrumbs={[{name:'搜索',url:'/search/'}]}><header class="page-intro"><p class="eyebrow">SEARCH THE NOTES</p><h1>找到你需要的那条线索。</h1><p>搜索在本地浏览器完成，无需提交个人信息。</p></header><label for="search">文章标题、用途或品牌名称</label><input type="search" id="search" class="search-input" placeholder="试试：预算、Windows、订阅链接"/><p id="search-count" class="status" role="status"></p><div id="search-results" class="grid">{list.map(a=><article class="card" data-search={(a.title+' '+a.description).toLowerCase()}><h2><a href={a.url}>{a.title}</a></h2><p>{a.description}</p><a href={a.url} class="text-link">查看内容 →</a></article>)}</div><noscript><p>JavaScript 已关闭，可在下方浏览全部条目，或使用浏览器查找。</p></noscript><script>const input=document.querySelector<HTMLInputElement>('#search')!;const cards=[...document.querySelectorAll<HTMLElement>('[data-search]')];function update(){const query=input.value.trim().toLowerCase().replace(/\s+/g,'');let n=0;cards.forEach(c=>{c.hidden=!c.dataset.search!.replace(/\s+/g,'').includes(query);if(!c.hidden)n++;});document.querySelector('#search-count')!.textContent=n?`找到 ${n} 条内容`:'没有找到匹配内容，试试更短的词。';}input.addEventListener('input',update);update();</script></Base>
