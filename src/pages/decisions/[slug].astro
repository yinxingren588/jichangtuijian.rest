---
import Base from '../../layouts/Base.astro';
import {decisionStudies} from '../../data/decision-studies';
import {airports,planPriceText,planTrafficText} from '../../data/airports';
import {renderBrandFacts} from '../../lib/brand-facts';
import {chooseMonthlyQuota,compareRecurringAndOneTime,videoBudget} from '../../lib/decision-examples';
export const getStaticPaths=()=>decisionStudies.map(study=>({params:{slug:study.slug},props:{study}}));
interface Props {study:typeof decisionStudies[number]}
const {study}=Astro.props;
const brand=airports.find(item=>item.slug===study.brandSlug)!;
const isRecurring=study.slug==='feiv-billing';
const isVideo=study.slug==='breezenet-tasks';
const names=(indices:number[])=>indices.length?indices.map(i=>brand.plans[i].name).join('、'):'当前两档的账面月额度均不足';
const quotaRows=[85,180,390].map(gb=>{const choice=chooseMonthlyQuota(brand.plans,gb,20);return [`月度计费流量${gb} GB`,`额外预留20%，准备${choice.required} GB`,names(choice.eligible)];});
const recurringRows=isRecurring?[[3,20],[12,10],[12,30]].map(([months,gb])=>{const result=compareRecurringAndOneTime(brand.plans[0],brand.plans[1],months,gb);return [`连续${months}个月，每月${gb} GB`,`累计${result.totalGB} GB；月付参考合计${brand.plans[0].currency} ${result.monthlyCost}`,result.onceFits?`一份一次性总量在账面上覆盖；参考支出${brand.plans[1].currency} ${result.onceCost}`:'一份一次性总量不足；不预设叠加或续购价格'];}):[];
const videoRows=[[1,3,50],[1.5,8,30],[3,15,50]].map(([hours,mbps,files])=>{const result=videoBudget(hours,mbps,30,files,1,20);return [`每天视频${hours}小时，平均${mbps} Mbps`,`30天＋文件${files} GB；假设1倍、预留20%，准备${result.required} GB`,names(chooseMonthlyQuota(brand.plans,result.billedGB,20).eligible)];});
const rows=isRecurring?recurringRows:isVideo?videoRows:quotaRows;
---
<Base title={study.title} description={renderBrandFacts(study.description,brand)} breadcrumbs={[{name:'选择案例',url:'/decisions/'},{name:brand.name+'案例',url:'/decisions/'+study.slug+'/'}]}>
 <header class="page-intro"><p class="eyebrow">A WORKED EXAMPLE / 把问题算清楚</p><h1>{study.title}</h1><p>{study.lead}</p><p class="muted">案例更新：2026-10-27 · 套餐来源读取：{brand.referenceChecked}</p></header>
 <article class="reader-case" data-decision-study={study.slug}>
  <section><span class="case-example-label">编辑演算示例 · 非真实用户账单</span><h2>{study.question}</h2><p>{isRecurring?'月付与一次性总量有不同的付款和额度模型。下面只在明确的使用月份与计费消耗假设下演算，不假设不限时包永远有效，也不推断可以叠加或续购。':isVideo?'先用平均传输速率与观看时长估算视频消耗，再加上文件与余量。平均速率是演算输入，不对应某个平台保证画质；规划倍率需要按实际线路规则调整。':'先把任务估算换算为计费流量，再给额度留出余量。下面的用量是便于理解档位的假设，不是站长实际月账单；实际倍率及上传扣量仍应另行确认。'}</p></section>
  <section><h2>对照的两档参考方案</h2><div class="reader-table-scroll" tabindex="0" role="region" aria-label="参考套餐与付款模型，可横向滚动"><table><thead><tr><th scope="col">方案</th><th scope="col">价格口径</th><th scope="col">流量口径</th></tr></thead><tbody>{brand.plans.map(plan=><tr><th scope="row">{plan.name}</th><td>{planPriceText(plan)}</td><td>{planTrafficText(plan)}</td></tr>)}</tbody></table></div><p>这里使用本站已有参考字段，不把优惠自动计入标价。{brand.coupon?`已录入优惠码${brand.coupon.code}对应优惠价永久有效（站长确认），具体适用与实付仍在结算核对。`:'本品牌未提供站长优惠码。'}<a href={'/airport/'+brand.slug+'/#checkout-proof'}> 查看结算凭据状态 →</a></p></section>
  <section><h2>三个情景怎样判断</h2><div class="reader-table-scroll" tabindex="0" role="region" aria-label="假设情景演算表，可横向滚动"><table><caption>以下均为明示假设，未声称已完成真实使用或购买</caption><thead><tr><th scope="col">情景假设</th><th scope="col">演算口径</th><th scope="col">账面判断</th></tr></thead><tbody>{rows.map(row=><tr>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div><p>{isRecurring?'月付合计按参考单价乘连续月份；一次性档只判断一份总额度是否覆盖累计用量。若一份不足，不能用数学上多买几份推断商家允许叠加，先核对续购与有效规则。':'容量比较只回答来源标示的额度能否覆盖输入预算，不表示节点速度、同时连接、平台权限或长期表现已经验证。'}</p></section>
  <section aria-labelledby="case-calculator"><h2 id="case-calculator">换成自己的预算，再算一次</h2>
   <form class="case-form" data-case-form>
    {isRecurring?<><label>计划连续使用的月份<input id="case-months" type="number" min="1" max="36" step="1" value="12" required/></label><label>每月计费流量预算（GB）<input id="case-monthly-gb" type="number" min="0" max="1000000" step="0.1" value="10" required/></label></>:isVideo?<><label>每天视频时长（小时）<input id="case-hours" type="number" min="0" max="24" step="0.1" value="1" required/></label><label>假设平均视频速率（Mbps）<input id="case-mbps" type="number" min="0.1" max="100" step="0.1" value="3" required/></label><label>本月使用天数<input id="case-days" type="number" min="1" max="31" step="1" value="30" required/></label><label>文件和更新预算（GB）<input id="case-files" type="number" min="0" max="1000000" step="0.1" value="50" required/></label><label>规划计费倍率（演算假设）<input id="case-multiplier" type="number" min="0.1" max="10" step="0.1" value="1" required/></label><label>额外预留比例（%）<input id="case-reserve" type="number" min="0" max="100" step="1" value="20" required/></label></>:<><label>月度计费流量预算（GB）<input id="case-billed" type="number" min="0" max="1000000" step="0.1" value="85" required/></label><label>额外预留比例（%）<input id="case-reserve" type="number" min="0" max="100" step="1" value="20" required/></label></>}
    <div class="case-form-action"><button type="submit" class="button">计算账面容量与参考支出</button><span class="fine-print">输入只在当前浏览器计算，不保存或上传。</span></div>
   </form><div class="case-result" id="case-result" role="status" aria-live="polite"><p>填写自己的预算后计算；也可直接阅读上面的三个静态演算情景。</p></div><noscript><p>交互演算需要JavaScript；上面的情景、假设、套餐及核对路径仍可完整阅读。</p></noscript>
  </section>
  <section><h2>容量判断之后，还要核对什么</h2><ul><li>目标节点与设备是否可用，所购套餐是否开放相同权限。</li><li>流量重置、上传扣量与实际倍率；月付到期与一次性额度有效条件。</li><li>结算金额、优惠适用范围、续费及退款规则。</li></ul><div class="case-reading"><a href={'/airport/'+brand.slug+'/#selection-heading'}>阅读{brand.name}站长结论 →</a><a href={'/airport/'+brand.slug+'/#performance-evidence'}>看本站真实测速图 →</a><a href={'/compare/?brands='+brand.slug}>加入自己的品牌对照 →</a><a href="/tools/traffic-calculator/">估算更多任务 →</a></div></section>
  <section><h2>继续读懂这些条件</h2><div class="case-reading">{study.related.map((url,index)=><a href={url}>{index===0?'阅读相关判断方法':'核对流量和计费规则'} →</a>)}<a href="/decisions/">返回全部选择案例 →</a><a href="/contact/">反馈你的实际问题 →</a></div></section>
 </article>
 <script id="case-data" type="application/json" set:html={JSON.stringify({kind:study.slug,plans:brand.plans}).replace(/</g,'\u003c')}/>
 <script>
  import {chooseMonthlyQuota,compareRecurringAndOneTime,videoBudget} from '../../lib/decision-examples';
  import type {Plan} from '../../data/airports';
  const config=JSON.parse(document.querySelector('#case-data')!.textContent!) as {kind:string;plans:Plan[]};
  const form=document.querySelector<HTMLFormElement>('[data-case-form]')!;const output=document.querySelector<HTMLElement>('#case-result p')!;
  const value=(id:string)=>{const input=document.querySelector<HTMLInputElement>('#'+id)!;if(!input.value.trim())throw Error('请填写所有演算字段。');return Number(input.value);};
  const names=(indices:number[])=>indices.length?indices.map(i=>config.plans[i].name).join('、'):'当前两档账面月额度均不足';
  form.addEventListener('submit',event=>{event.preventDefault();try{
   if(config.kind==='feiv-billing'){const result=compareRecurringAndOneTime(config.plans[0],config.plans[1],value('case-months'),value('case-monthly-gb'));output.textContent=`累计计费预算${result.totalGB} GB。月付参考合计${config.plans[0].currency} ${result.monthlyCost}，${result.monthlyFits?'每月额度在账面上覆盖':'单月额度不足或尚未知'}；${result.onceFits?`一份一次性总量在账面上覆盖，参考支出${config.plans[1].currency} ${result.onceCost}`:'一份一次性总量不足或尚未知，不预估叠加或续购价格'}。有效条件、节点及结算需分别核对。`;}
   else if(config.kind==='breezenet-tasks'){const result=videoBudget(value('case-hours'),value('case-mbps'),value('case-days'),value('case-files'),value('case-multiplier'),value('case-reserve'));const choice=chooseMonthlyQuota(config.plans,result.billedGB,value('case-reserve'));output.textContent=`视频传输量约${result.videoGB.toFixed(2)} GB；加上文件、规划倍率与余量后准备${result.required} GB。按来源标示月额度：${names(choice.eligible)}。倍率是本次输入假设，不是商家已核验规则。`;}
   else {const result=chooseMonthlyQuota(config.plans,value('case-billed'),value('case-reserve'));output.textContent=`加入余量后准备${result.required} GB计费额度。按来源标示月额度：${names(result.eligible)}。如果两档均够用，仍应结合预算和完整权益选择；账面够用不代表连接或结算已验证。`;}
  }catch(error){output.textContent=error instanceof Error?error.message:'请检查输入。';}});
 </script>
</Base>
