---
import Base from '../layouts/Base.astro';
import OrbitArt from '../components/OrbitArt.astro';
import CoreReadingRoutes from '../components/CoreReadingRoutes.astro';
import HomeSelectionGuide from '../components/HomeSelectionGuide.astro';
import {partnerAirports,planPriceText,planTrafficText} from '../data/airports';
import {getCollection} from 'astro:content';
import {ordered,categoryFor} from '../lib/content';
const entries=await getCollection('articles',a=>!a.data.draft);
const posts=ordered(entries.filter(a=>a.data.section==='blog'));
const guides=entries.filter(a=>a.data.section==='guides');
const selected=['yinxingren','breezenet','feimaoyun'].map(slug=>partnerAirports.find(a=>a.slug===slug)!);
const planCount=partnerAirports.reduce((sum,a)=>sum+a.plans.length,0);
const couponCount=partnerAirports.filter(a=>a.coupon).length;
---
<Base title="机场推荐与节点选择指南｜品牌套餐、优惠与连接知识" description="机场推荐从预算、月度用量和节点需求开始。对照28家机场参考套餐、优惠码与测速图，按月付、低预算或一次性总量建立候选；使用流量需求计算器估算额度，再查看品牌条件、成本方法与配置教程。" keywords={["机场推荐"]}>
<section class="tech-hero" aria-labelledby="hero-title">
 <div class="hero-copy"><p class="eyebrow"><span class="light-dot"></span> 把复杂的选择，变得清楚</p><h1 id="hero-title">机场推荐。<br/><em>先看清选择。</em></h1><p class="hero-description">机场推荐从预算和任务开始。<br/>价格、流量、节点与使用方法，一处看清。</p><div class="hero-actions"><a class="button" href="/airport/">探索品牌套餐 <span>↗</span></a><a class="quiet-button" href="/tools/traffic-calculator/">估算月度流量 <span>→</span></a><a class="quiet-button" href="/compare/">打开比较工具 <span>→</span></a></div><div class="hero-meta"><a href="/airport/"><b>{partnerAirports.length}</b><span>机场品牌</span></a><a href="/airport/"><b>{planCount}</b><span>参考套餐</span></a><a href="/airport/"><b>{couponCount}</b><span>优惠码</span></a></div></div>
 <div class="hero-visual"><OrbitArt/><div class="visual-label top-label"><span>资料索引</span><b>品牌 / 价格 / 流量</b></div><div class="visual-label bottom-label"><span>使用指南</span><b>{posts.length} 篇文章 · {guides.length} 篇教程</b></div></div>
</section>
<HomeSelectionGuide/>
<section class="plan-section" aria-labelledby="plan-title"><div class="section-head"><div><p class="eyebrow">BRAND EXPLORER</p><h2 id="plan-title">从品牌，到适合你的方案。</h2></div><a href="/airport/" class="text-link">全部品牌 ↗</a></div><div class="plan-grid">{selected.map(a=><a class="plan-card" href={'/airport/'+a.slug+'/'}><div class="card-brand"><span class="brand-monogram" aria-hidden="true">{a.name[0]}</span><span>{a.name}<small>第三方参考套餐</small></span><span class="tiny-arrow" aria-hidden="true">↗</span></div><p class="plan-price">{planPriceText(a.plans[0])}</p><p class="plan-traffic">{planTrafficText(a.plans[0])}</p><div class="card-bottom"><span>{a.coupon?<>优惠码 <code>{a.coupon.code}</code></>:'查看全部套餐'}</span><span>查看档案 →</span></div></a>)}</div><p class="fine-print">价格与流量为第三方参考，尚未验证商家结算；已录入优惠码对应优惠价永久有效（站长确认）；具体折扣与适用范围按方案核对。品牌含推广链接，本站可能获得佣金。展示顺序不代表排名。</p></section>
<CoreReadingRoutes/>
<div class="modern-resources"><a href="/guides/"><span>01 / GET STARTED</span><h2>配置不复杂。<br/>一步一步来。</h2><p>Windows、macOS、iOS 与 Android 操作指南。</p><b>打开 {guides.length} 篇教程 →</b></a><a href="/blog/"><span>02 / KNOW THE DIFFERENCE</span><h2>把参数读明白。<br/>选择更有把握。</h2><p>预算、流量、线路、隐私与实际使用需求。</p><b>阅读 {posts.length} 篇知识文章 →</b></a></div>
<section class="brand-index-section" aria-labelledby="index-title"><div class="section-head"><div><p class="eyebrow">THE FULL PICTURE</p><h2 id="index-title">你的候选，都在这里。</h2></div><a class="text-link" href="/compare/">横向比较 ⇄</a></div><div class="brand-cloud">{partnerAirports.map(a=><a href={'/airport/'+a.slug+'/'}><span class="brand-cloud-icon" aria-hidden="true">{a.name[0]}</span>{a.name}<span class="cloud-arrow" aria-hidden="true">↗</span></a>)}</div><p class="fine-print">完整收录 {partnerAirports.length} 家机场品牌。顺序不代表排名，全部资料的来源与核验范围见对应档案。</p></section>
<section class="home-evidence" aria-labelledby="home-evidence-title"><div><p class="eyebrow">THE CHART ARCHIVE / 全新收录</p><h2 id="home-evidence-title">从文字资料，看到节点图表。</h2><p>29 组测速、流媒体与 AI 状态图。按品牌查找，查看场景时间，放大或下载高清原图。</p><p class="fine-print">维护者提供 · 2026 年 10 月场景 · 站长本人实测</p><a class="button" href="/evidence/">打开测速图表库 ↗</a></div><div class="home-evidence-art" aria-hidden="true"><span>CHARTS / OCT 2026</span><b>29<small>组</small></b><div>{[35,60,45,80,67,100,75,90,61,83].map(height=><i style={'height:'+height+'%'}></i>)}</div><p>节点测速 × 流媒体 × AI</p></div></section>
<section class="home-reading" aria-labelledby="reading-title"><div class="section-head"><div><p class="eyebrow">THE KNOWLEDGE BASE</p><h2 id="reading-title">把选择，建立在理解之上。</h2></div><a class="text-link" href="/blog/">全部文章 ↗</a></div><div class="home-reading-grid">{posts.slice(0,4).map(a=><article><span class="article-kicker">{categoryFor(a)}</span><h3><a href={'/blog/'+a.id+'/'}>{a.data.title}</a></h3><p>{a.data.description}</p><span class="entry-date">{a.data.updated} · AI 辅助整理</span></article>)}</div></section>
<div class="home-method"><div><p class="eyebrow">CLARITY FIRST</p><h2>资料有出处，选择有依据。</h2><p>已收录站长原创实测图表。了解我们如何区分公开资料、推广关系与实测证据。</p></div><a href="/editorial-policy/" class="button secondary">阅读编辑政策 ↗</a></div>
</Base>
