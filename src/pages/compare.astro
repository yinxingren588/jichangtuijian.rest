---
import Base from '../layouts/Base.astro';
import {airports,priceText,trafficText,sourceLabel} from '../data/airports';
import Coupon from '../components/Coupon.astro';
import {evidenceFor} from '../data/evidence';
import {comparisonBrand} from '../lib/comparison';
const data=airports.map(comparisonBrand);
---
<Base title="品牌套餐与测速对比工具：核对 2–4 家品牌" description="选择 2–4 家品牌，对照价格、流量和优惠条件，切换查看维护者提供图表中的速度、延迟、平台状态及测试日期。不同来源与未知字段分别标明。" breadcrumbs={[{name:'横向比较',url:'/compare/'}]}>
<header class="page-intro"><p class="eyebrow">COMPARE / 放在一起看</p><h1>少一点猜测，多一点对照。</h1><p>选好候选，再切换套餐条件与测速图表。让价格、时间和指标都保留自己的含义。</p></header>
<div class="note">收录 28 家机场参考档案及 5 家 VPN 官方资料。不同类别、币种、付款周期与无限流量方案不能直接按单价排序；维护者图表未独立复测。</div>
<div class="comparison-workspace" id="compare-workspace"><div class="compare-controls"><label for="brand-select" class="sr-only">选择候选品牌</label><select id="brand-select"><option value="">选择要添加的品牌</option>{data.map(a=><option value={a.slug}>{a.name}（{a.kind==='vpn'?'VPN':'机场'}）</option>)}</select><button id="add-brand" class="button">添加候选</button></div><div id="selected-brands" aria-label="已选品牌"></div>
<div class="compare-toolbar"><div class="compare-modes" role="group" aria-label="选择比较内容"><button type="button" data-compare-mode="plans" aria-pressed="true" aria-controls="compare-result">套餐条件</button><button type="button" data-compare-mode="charts" aria-pressed="false" aria-controls="compare-result">测速与解锁</button><button type="button" data-compare-mode="all" aria-pressed="false" aria-controls="compare-result">全部资料</button></div><a class="text-link" href="/evidence/">全部原始图表 ↗</a></div>
<div class="compare-save-tools" aria-label="保存与分享对比"><button type="button" id="copy-comparison" disabled>复制对比链接 ⧉</button><button type="button" id="save-comparison" disabled>保存到本机</button><button type="button" id="restore-comparison" disabled>恢复已保存</button><button type="button" id="clear-saved-comparison" disabled>删除已保存</button><a href="/airport/#my-brands">我的候选清单 →</a></div><p class="compare-save-status" id="comparison-save-status" role="status" aria-live="polite">所选品牌与视图会同步到网址，刷新后可恢复。</p><div id="comparison-share-box" class="comparison-share-box" hidden><label for="comparison-share-url">当前对比链接</label><input id="comparison-share-url" type="text" readonly/></div>
<p class="guide-tutorial-links"><a href="/guides/prepare-comparison-sheet/">查看比较、保存与分享图文教程 →</a></p>
<p id="compare-status" class="status" role="status" aria-live="polite">请至少添加 2 家品牌，最多 4 家。</p><div id="compare-result"></div>
<div id="compare-chart-note" class="comparison-chart-note" hidden><strong>先看时间，再看差异。</strong><p>下载单位为 MB/s；平均值为节点等权均值，最高值为各节点峰值中的最大值。各品牌场景时间不同，运营商、设备和带宽未提供，不能当作同条件速度排名。平台 n/60 为绿色状态节点数，非独立请求成功率；Steam 货币区显示不作解锁率。缺少图表的品牌保留“未提供图表”，不填零。</p></div></div>
<noscript><div class="note">交互比较需要 JavaScript。下方已列出全部品牌资料，每个机场均可打开对应图表。</div></noscript>
<section><div class="section-head"><div><h2>完整资料概览</h2><p>套餐金额与优惠码保留原始口径。点击图表入口，可查看场景时间、完整节点及平台状态。</p></div></div><div class="table-wrap"><table><thead><tr><th scope="col">品牌</th><th scope="col">计费条件</th><th scope="col">流量说明</th><th scope="col">优惠码</th><th scope="col">资料状态</th><th scope="col">品牌入口</th></tr></thead><tbody>{airports.map(a=><tr><th scope="row"><a href={'/airport/'+a.slug+'/'}>{a.name}</a><br/><span class="tag neutral">{a.kind==='vpn'?'VPN':'机场'} · 未独立实测</span>{evidenceFor(a.slug)&&<a class="directory-evidence-link" href={'/airport/'+a.slug+'/#performance-evidence'}>测速与解锁图 ↗</a>}</th><td>{priceText(a)}</td><td>{trafficText(a)}</td><td><Coupon brand={a} compact/></td><td><a href={a.sources[0]} target="_blank" rel="noopener noreferrer">{sourceLabel(a)} ↗</a><br/>{a.referenceChecked||a.lastVerified}</td><td>{a.affiliateUrl?<a href={a.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">推广入口 ↗</a>:<a href={a.officialUrl} target="_blank" rel="noopener noreferrer">官方资料入口 ↗</a>}</td></tr>)}</tbody></table></div></section>
<script id="compare-data" type="application/json" set:html={JSON.stringify(data).replace(/</g,'\u003c')}/>
<script>
import {comparisonFields,comparisonMode,selectedBrandSlugs,type ComparisonBrand,type CompareMode} from '../lib/comparison-fields';
import {comparisonSearch,createBrandMemoryStore,memoryKey} from '../lib/brand-memory';
const brands:ComparisonBrand[]=JSON.parse(document.querySelector('#compare-data')!.textContent!);
const params=new URLSearchParams(location.search);const selected=selectedBrandSlugs(params.get('brands'),brands);let mode:CompareMode=comparisonMode(params.get('view'));
const select=document.querySelector<HTMLSelectElement>('#brand-select')!;const status=document.querySelector('#compare-status')!;const result=document.querySelector('#compare-result')!;const chips=document.querySelector('#selected-brands')!;const modes=[...document.querySelectorAll<HTMLButtonElement>('[data-compare-mode]')];
const memory=createBrandMemoryStore(brands),copyButton=document.querySelector<HTMLButtonElement>('#copy-comparison')!,saveButton=document.querySelector<HTMLButtonElement>('#save-comparison')!,restoreButton=document.querySelector<HTMLButtonElement>('#restore-comparison')!,clearSaved=document.querySelector<HTMLButtonElement>('#clear-saved-comparison')!,saveStatus=document.querySelector<HTMLElement>('#comparison-save-status')!,shareInput=document.querySelector<HTMLInputElement>('#comparison-share-url')!,shareBox=document.querySelector<HTMLElement>('#comparison-share-box')!;
function savedControls(){const saved=memory.read().comparison;restoreButton.disabled=!saved;clearSaved.disabled=!saved;}
function cell(tag:string,text:string){const e=document.createElement(tag);e.textContent=text;return e;}
function draw(){
 const query=comparisonSearch(selected,mode,brands);if(location.search!==query)history.replaceState(null,'',location.pathname+query+location.hash);
 copyButton.disabled=selected.length<2;saveButton.disabled=selected.length<2;shareInput.value=location.href;
 chips.replaceChildren();for(const slug of selected){const b=brands.find(a=>a.slug===slug)!;const chip=cell('span',b.name);chip.className='chip';const remove=cell('button','×');remove.setAttribute('aria-label','移除 '+b.name);remove.addEventListener('click',()=>{selected.splice(selected.indexOf(slug),1);draw();});chip.append(remove);chips.append(chip);}
 modes.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.compareMode===mode)));
 document.querySelector<HTMLElement>('#compare-chart-note')!.hidden=mode==='plans'||selected.length<2;
 result.replaceChildren();status.textContent=selected.length<2?'请至少选择 2 家品牌，最多 4 家。':`已选择 ${selected.length} 家 · ${mode==='plans'?'套餐条件':mode==='charts'?'测速与解锁图表':'全部资料'} · 来源状态分别标明`;
 if(selected.length<2){const empty=cell('div','添加至少两个候选后，可切换查看套餐与测速资料。');empty.className='empty card';result.append(empty);return;}
 const hint=cell('p','左右滑动可看完整对照；表格下方可打开各品牌原图。');hint.className='compare-scroll-hint';result.append(hint);
 const wrap=document.createElement('div');wrap.className='table-wrap selected-comparison';wrap.tabIndex=0;wrap.setAttribute('role','region');wrap.setAttribute('aria-label','所选品牌对照表，可横向滚动');
 const table=document.createElement('table');table.dataset.compareView=mode;table.style.setProperty('--compare-columns',String(selected.length));
 const caption=cell('caption','所选品牌'+(mode==='plans'?'套餐条件':mode==='charts'?'图示测速与平台状态':'全部资料')+'对照');table.append(caption);
 const head=document.createElement('thead');const hr=document.createElement('tr');const dimension=cell('th','比较维度');dimension.setAttribute('scope','col');hr.append(dimension);
 for(const slug of selected){const b=brands.find(x=>x.slug===slug)!;const th=document.createElement('th');th.scope='col';const link=cell('a',b.name) as HTMLAnchorElement;link.href='/airport/'+slug+'/';th.append(link);hr.append(th);}head.append(hr);table.append(head);
 const body=document.createElement('tbody');for(const field of comparisonFields.filter(f=>mode==='all'||f.group===mode)){const row=document.createElement('tr');row.dataset.comparisonField=field.key;const th=cell('th',field.label);th.setAttribute('scope','row');row.append(th);for(const slug of selected)row.append(cell('td',brands.find(b=>b.slug===slug)!.values[field.key]));body.append(row);}table.append(body);wrap.append(table);result.append(wrap);
 const links=document.createElement('div');links.className='compare-chart-links';links.setAttribute('aria-label','所选品牌资料入口');for(const slug of selected){const b=brands.find(x=>x.slug===slug)!;const link=cell('a',b.name+(b.hasCharts?' · 查看测速与解锁原图 ↗':' · 查看品牌资料 ↗')) as HTMLAnchorElement;link.href='/airport/'+slug+'/'+(b.hasCharts?'#performance-evidence':'');links.append(link);}result.append(links);
}
for(const button of modes)button.addEventListener('click',()=>{mode=comparisonMode(button.dataset.compareMode||null);draw();});
document.querySelector('#add-brand')!.addEventListener('click',()=>{if(!select.value){status.textContent='请先选择一个品牌。';return;}if(selected.includes(select.value)){status.textContent='该品牌已经加入比较。';return;}if(selected.length>=4){status.textContent='最多比较 4 家，请先移除一个品牌。';return;}selected.push(select.value);select.value='';draw();});
copyButton.addEventListener('click',async()=>{if(selected.length<2)return;try{await navigator.clipboard.writeText(location.href);saveStatus.textContent='对比链接已复制，打开后会恢复相同品牌与视图。';shareBox.hidden=true;}catch{shareBox.hidden=false;shareInput.value=location.href;shareInput.focus();shareInput.select();saveStatus.textContent='请手动复制下方对比链接。';}});
saveButton.addEventListener('click',()=>{if(selected.length<2)return;const current=memory.read();const persisted=memory.write({...current,comparison:{brands:[...selected],view:mode}});savedControls();saveStatus.textContent=persisted?'当前对比已保存到本机，可使用“恢复已保存”找回。':'当前浏览器不允许长期保存，请复制对比链接保留结果。';});
restoreButton.addEventListener('click',()=>{const saved=memory.read().comparison;if(!saved){savedControls();saveStatus.textContent='没有可恢复的对比。';return;}selected.splice(0,selected.length,...saved.brands);mode=saved.view;draw();saveStatus.textContent='已恢复保存的品牌与视图。';});
clearSaved.addEventListener('click',()=>{memory.write({...memory.read(),comparison:null});savedControls();saveStatus.textContent='已删除本机保存的对比，当前页面选择保持不变。';});
window.addEventListener('brand-memory-change',savedControls);window.addEventListener('storage',event=>{if(event.key===memoryKey||event.key===null)savedControls();});
window.addEventListener('popstate',()=>{const next=new URLSearchParams(location.search);selected.splice(0,selected.length,...selectedBrandSlugs(next.get('brands'),brands));mode=comparisonMode(next.get('view'));draw();});
draw();savedControls();
</script></Base>
