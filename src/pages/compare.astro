---
import Base from '../layouts/Base.astro';
import {airports,priceText,trafficText,costPerGB,sourceLabel} from '../data/airports';
import Coupon from '../components/Coupon.astro';
const data=airports.map(a=>({slug:a.slug,name:a.name,kind:a.kind,values:[a.kind==='vpn'?'商业 VPN':'订阅机场',priceText(a),trafficText(a),a.coupon?a.coupon.code+'（维护者提供，未验证）':'未提供',a.plans.map(p=>{const n=costPerGB(p);return n===null?'不适用 / 未核实倍率或周期':p.currency+' '+n.toFixed(3)+'/GB'}).join('；')||'尚未核实',a.regions.join('、')||'尚未核实',a.protocols.join('、')||'尚未核实',a.deviceLimit||'尚未核实',a.aiSupport?.join('、')||'尚未核实',a.streamingSupport?.join('、')||'尚未核实',a.advantages.join('；')||'尚未实测',a.disadvantages.join('；'),sourceLabel(a)+' / '+(a.referenceChecked||a.lastVerified||'尚未核实')]}));
---
<Base title="机场与 VPN 横向比较工具：核对 2–4 家品牌" description="从统一资料库选择 2–4 家品牌，对照价格周期、流量、每 GB 成本、协议和设备限制；VPN 与订阅机场分别标明，未核实字段保持未知。" breadcrumbs={[{name:'横向比较',url:'/compare/'}]}>
<header class="page-intro"><p class="eyebrow">COMPARE / 放在一起看</p><h1>少一点猜测，多一点对照。</h1><p>选择 2–4 家品牌。只比较公开资料，不把未知项变成优势。</p></header>
<div class="note">现有 28 家机场参考档案和 5 家 VPN 官方资料，来源与类别分别标明。不同类别、币种、计费周期和无限流量套餐不能直接按单价排序。</div>
<div class="compare-controls"><label for="brand-select" class="sr-only">选择候选品牌</label><select id="brand-select"><option value="">选择要添加的品牌</option>{data.map(a=><option value={a.slug}>{a.name}（{a.kind==='vpn'?'VPN':'机场'}）</option>)}</select><button id="add-brand" class="button">添加候选</button></div><div id="selected-brands" aria-label="已选品牌"></div><p id="compare-status" class="status" role="status" aria-live="polite">请至少添加 2 家品牌，最多 4 家。</p><div id="compare-result"></div>
<noscript><div class="note">交互比较需要 JavaScript。以下为构建时生成的公开资料，也可打开各品牌档案阅读全文。</div></noscript>
<section><div class="section-head"><div><h2>完整资料概览</h2><p>价格、流量与优惠码来自统一数据库。推广链接可能为本站带来佣金。</p></div></div><div class="table-wrap"><table><thead><tr><th scope="col">品牌</th><th scope="col">计费条件</th><th scope="col">流量说明</th><th scope="col">优惠码</th><th scope="col">来源</th><th scope="col">品牌入口</th></tr></thead><tbody>{airports.map(a=><tr><th scope="row"><a href={'/airport/'+a.slug+'/'}>{a.name}</a><br/><span class="tag neutral">{a.kind==='vpn'?'VPN':'机场'} · 未实测</span></th><td>{priceText(a)}</td><td>{trafficText(a)}</td><td><Coupon brand={a} compact/></td><td><a href={a.sources[0]} target="_blank" rel="noopener noreferrer">{sourceLabel(a)} ↗</a><br/>{a.referenceChecked||a.lastVerified}</td><td>{a.affiliateUrl?<a href={a.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer">推广入口 ↗</a>:<a href={a.officialUrl} target="_blank" rel="noopener noreferrer">官方资料入口 ↗</a>}</td></tr>)}</tbody></table></div></section>
<script id="compare-data" type="application/json" set:html={JSON.stringify(data).replace(/</g,'\u003c')}/>
<script>
type Brand={slug:string;name:string;values:string[]};
const brands:Brand[]=JSON.parse(document.querySelector('#compare-data')!.textContent!);
const selected:string[]=[];const select=document.querySelector<HTMLSelectElement>('#brand-select')!;const status=document.querySelector('#compare-status')!;const result=document.querySelector('#compare-result')!;const chips=document.querySelector('#selected-brands')!;
const fields=['类别','价格 / 周期','流量','优惠码（未验证）','每 GB 成本（月付）','节点地区','协议','设备限制','AI 支持','流媒体支持','优势','注意事项','来源 / 读取日期'];
function cell(tag:string,text:string){const e=document.createElement(tag);e.textContent=text;return e;}
function draw(){chips.replaceChildren();for(const slug of selected){const b=brands.find(a=>a.slug===slug)!;const chip=cell('span',b.name);chip.className='chip';const remove=cell('button','×');remove.setAttribute('aria-label','移除 '+b.name);remove.addEventListener('click',()=>{selected.splice(selected.indexOf(slug),1);draw();});chip.append(remove);chips.append(chip);}result.replaceChildren();status.textContent=selected.length<2?'请至少选择 2 家品牌，最多 4 家。':`已选择 ${selected.length} 家；以下为来源资料整理，未实测。`;if(selected.length<2){const empty=cell('div','还没有足够的候选。添加品牌后，这里会显示逐项比较。');empty.className='empty card';result.append(empty);return;}const wrap=document.createElement('div');wrap.className='table-wrap';const table=document.createElement('table');const caption=cell('caption','所选品牌公开字段比较');table.append(caption);const head=document.createElement('thead');const hr=document.createElement('tr');hr.append(cell('th','比较维度'));for(const s of selected){const th=cell('th',brands.find(b=>b.slug===s)!.name);th.setAttribute('scope','col');hr.append(th);}head.append(hr);table.append(head);const body=document.createElement('tbody');fields.forEach((name,i)=>{const row=document.createElement('tr');const th=cell('th',name);th.setAttribute('scope','row');row.append(th);for(const s of selected)row.append(cell('td',brands.find(b=>b.slug===s)!.values[i]));body.append(row);});table.append(body);wrap.append(table);result.append(wrap);}
document.querySelector('#add-brand')!.addEventListener('click',()=>{if(!select.value){status.textContent='请先选择一个品牌。';return;}if(selected.includes(select.value)){status.textContent='该品牌已经加入比较。';return;}if(selected.length>=4){status.textContent='最多比较 4 家，请先移除一个品牌。';return;}selected.push(select.value);select.value='';draw();});
for(const s of (new URLSearchParams(location.search).get('brands')||'').split(',')){if(brands.some(b=>b.slug===s)&&!selected.includes(s)&&selected.length<4)selected.push(s);}draw();
</script></Base>
