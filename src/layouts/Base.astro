---
import '../styles/global.css';
import '../styles/readability.css';
import '../styles/core-reading.css';
import ChartViewer from '../components/ChartViewer.astro';
import BrandMemoryClient from '../components/BrandMemoryClient.astro';
import {site} from '../data/site';
interface Props {title:string;description:string;keywords?:string[];noindex?:boolean;breadcrumbs?:{name:string;url:string}[];schema?:Record<string,unknown>[]}
const {title,description,keywords=[],noindex=false,breadcrumbs=[],schema=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
const nav=[['首页','/'],['品牌套餐','/airport/'],['横向对比','/compare/'],['操作教程','/guides/'],['知识文章','/blog/'],['推荐专题','/recommend/'],['测速图表','/evidence/'],['我的清单','/airport/#my-brands']];
const graph=[{'@type':'Organization','@id':site.url+'/#organization',name:site.name,url:site.url},{'@type':'WebSite','@id':site.url+'/#website',name:site.name,url:site.url,inLanguage:'zh-CN'},...(breadcrumbs.length?[{'@type':'BreadcrumbList',itemListElement:[{name:'首页',url:'/'},...breadcrumbs].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,site.url).href}))}]:[]),...schema];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · {site.name}</title><meta name="description" content={description}/>{keywords.length>0&&<meta name="keywords" content={keywords.join(", ")}/>}<link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex, follow':'index, follow'}/><meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.name}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\u003c')}/></head><body>
<a class="skip" href="#main">跳至正文</a><header class="site-header"><div class="wrap header-inner"><a class="logo" href="/" aria-label="航线笔记首页"><span class="logo-mark" aria-hidden="true">↗</span><span>航线笔记</span><small>ROUTE</small></a><button class="menu-button" aria-expanded="false" aria-controls="navigation">菜单 ☰</button><nav class="nav" id="navigation" aria-label="主导航">{nav.map(([label,url])=><a href={url} aria-current={(url==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(url))?'page':undefined}>{label}</a>)}<a class="search-link" href="/search/">搜索资料 ⌕</a></nav><a class="header-search" href="/search/">搜索资料 <span>⌕</span></a></div></header>
<main id="main" class="wrap">{breadcrumbs.length>0&&<nav class="breadcrumb" aria-label="面包屑"><a href="/">首页</a>{breadcrumbs.map((b,i)=><><span aria-hidden="true">/</span>{i===breadcrumbs.length-1?<span aria-current="page">{b.name}</span>:<a href={b.url}>{b.name}</a>}</>)}</nav>}<slot/></main>
<footer class="footer"><div class="wrap"><div class="footer-top"><div><a href="/" class="logo">航线笔记<span class="text-link">↗</span></a><p class="muted">选得明白，连接从容。</p></div><nav class="footer-links" aria-label="页脚导航">{[['VPN推荐','/vpn/'],['测速图表','/evidence/'],['评测方法','/review/'],['推荐专题','/recommend/'],['品牌资料','/airport/'],['知识百科','/glossary/'],['关于我们','/about/'],['编辑政策','/editorial-policy/'],['联系与纠错','/contact/'],['隐私政策','/privacy-policy/'],['免责声明','/disclaimer/'],['Sitemap','/sitemap-index.xml']].map(([n,u])=><a href={u}>{n}</a>)}</nav></div><div class="footer-bottom"><span>© 2026 航线笔记 · 独立整理公开资料，持续记录核验边界。</span><span>无付费排名 · 部分品牌含推广链接 · 不保证连接与平台可用性</span></div></div></footer>
<script>const button=document.querySelector<HTMLButtonElement>('.menu-button');const nav=document.querySelector<HTMLElement>('#navigation');function setMenu(open:boolean){button?.setAttribute('aria-expanded',String(open));nav?.setAttribute('data-open',String(open));}button?.addEventListener('click',()=>setMenu(button.getAttribute('aria-expanded')!=='true'));document.addEventListener('keydown',event=>{if(event.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){setMenu(false);button.focus();}});</script>
<ChartViewer/>
<BrandMemoryClient/>
</body></html>
